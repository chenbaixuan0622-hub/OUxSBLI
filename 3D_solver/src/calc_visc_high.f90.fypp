#:include 'config.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
#:if not defined('VISC_STENCIL')
  #:set VISC_STENCIL = 'Central'
#:endif
#:set is_les = (VISC == 'LES')
#:set base_suf = ""
#:if VISC_ORDER == 2
module calc_visc_high
end module calc_visc_high
#:else
module calc_visc_high
  use libm
  use mod_globals, only : gamma, R, Pr, Prt, dt, threadsEv, threadsFv, threadsGv
  use mod_constant, only : id_visc, Cp, gamma_1, Cp_over_Pr, one_third, two_third, one_twelfth
  use libm
  #:if VISC_ORDER == 4
  use load_smem_visc_cent4
  #:elif VISC_STENCIL == 'ME4Base'
  use load_smem_visc_me4_base
  #:else
  use load_smem_visc_cent6
  #:endif
  implicit none
  private
  public calc_Ev${VISC_ORDER}$, calc_Fv${VISC_ORDER}$, calc_Gv${VISC_ORDER}$, &
         calc_Ev${VISC_ORDER}$_koff, calc_Fv${VISC_ORDER}$_koff, calc_Gv${VISC_ORDER}$_koff
  real(8), parameter :: one_24 = 1.d0 / 24.d0
contains
  #:if VISC_ORDER == 4
  #:include 'calc_visc_cent.f90.fypp'
  #:elif VISC_STENCIL == 'ME4Base'
  include 'calc_visc_me4_base.f90'
  #:else
  #:include 'calc_visc_cent.f90.fypp'
  #:endif

#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Ev${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    E)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsEv%x + 2*io_v + 1
    integer, parameter :: sy = threadsEv%y
    integer, parameter :: sz = threadsEv%z
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uy
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vy
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uz
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wz
    integer i, j, k, it, jt, kt, ii, idx, offset_yz
    real(8) :: kTx, utau_sum
    real(8) :: dyj, dzk
    #:if is_les
    real(8) Hsgs
    #:endif
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_yz = (jt-1)*sx + (kt-1)*sx*sy
    dyj = dy(j)
    dzk = dz(k)
    #:if VISC_ORDER == 4
    call load_smem_visc_cent4_x(it, jt, kt, j, k, nx, ny, nz, dyj, dzk, Q_2, Q_3, Q_4, u, v, w, uy, vy, uz, wz)
    #:elif VISC_STENCIL == 'ME4Base'
    call load_smem_visc_me4_base_x(it, jt, kt, j, k, nx, ny, nz, dyj, dzk, Q_2, Q_3, Q_4, u, v, w, uy, vy, uz, wz)
    #:else
    call load_smem_visc_cent6_x(it, jt, kt, j, k, nx, ny, nz, dyj, dzk, Q_2, Q_3, Q_4, u, v, w, uy, vy, uz, wz)
    #:endif
    i  = (blockIdx%x-1)*blockDim%x + it
    idx = it + offset_yz
    #:if is_koff
    if (nx-1 < i .or. ny-1 < j .or. k_hi < k) return
    #:else
    if (nx-1 < i .or. ny-1 < j .or. nz-1 < k) return
    #:endif
    #:if VISC_ORDER == 4
    if (2 <= i .and. i <= nx-2 .and. 3 <= j .and. j <= ny-2 .and. 3 <= k .and. k <= nz-2) then
      block
        real(8) :: mu4(4)
        real(8) :: dxi
        #:if is_les
        real(8) :: mut4(4)
        mut4(:) = mut(i-1:i+2, j, k)
        #:endif
        mu4(:) = mu(i-1:i+2, j, k)
        dxi = dx(i)
        kTx = Cp_over_Pr * interp4(mu4) * diff4(dxi, T(i-1:i+2, j, k))
        #:if is_les
        block
          real(8) :: H(4)
          H(:) = Cp * T(i-1:i+2,j,k) + 0.5d0 * (u(idx-1:idx+2)**2 + v(idx-1:idx+2)**2 + w(idx-1:idx+2)**2) + qc2(i-1:i+2,j,k)
          Hsgs = -interp4(mut4) * diff4(dxi, H) / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu4, mut4, u(idx-1:idx+2), vy(idx-1:idx+2), wz(idx-1:idx+2), dxi, tau, utau)
          #:else
          call calc_tau_straight(mu4, u(idx-1:idx+2), vy(idx-1:idx+2), wz(idx-1:idx+2), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu4, mut4, v(idx-1:idx+2), uy(idx-1:idx+2), dxi, tau, utau)
          #:else
          call calc_tau_cross(mu4, v(idx-1:idx+2), uy(idx-1:idx+2), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu4, mut4, w(idx-1:idx+2), uz(idx-1:idx+2), dxi, tau, utau)
          #:else
          call calc_tau_cross(mu4, w(idx-1:idx+2), uz(idx-1:idx+2), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:elif VISC_STENCIL == 'ME4Base'
    if (3 <= i .and. i <= nx-3 .and. 3 <= j .and. j <= ny-2 .and. 3 <= k .and. k <= nz-2) then
      block
        real(8) :: mu3(3)
        real(8) :: mum2, mum1, mu0, mup1, mup2, mup3
        real(8) :: Tm2, Tm1, T0, Tp1, Tp2, Tp3
        real(8) :: dxi
        #:if is_les
        real(8) :: mut3(3)
        real(8) :: mutm2, mutm1, mut0, mutp1, mutp2, mutp3
        mutm2 = mut(i-2,j,k)
        mutm1 = mut(i-1,j,k)
        mut0  = mut(i,  j,k)
        mutp1 = mut(i+1,j,k)
        mutp2 = mut(i+2,j,k)
        mutp3 = mut(i+3,j,k)
        mut3(1) = 0.0625d0 * fma(9.d0, mutm1+mut0,  -(mutm2+mutp1))
        mut3(2) = 0.0625d0 * fma(9.d0, mut0 +mutp1, -(mutm1+mutp2))
        mut3(3) = 0.0625d0 * fma(9.d0, mutp1+mutp2, -(mut0 +mutp3))
        #:endif
        mum2 = mu(i-2,j,k)
        mum1 = mu(i-1,j,k)
        mu0  = mu(i,  j,k)
        mup1 = mu(i+1,j,k)
        mup2 = mu(i+2,j,k)
        mup3 = mu(i+3,j,k)
        mu3(1) = 0.0625d0 * fma(9.d0, mum1+mu0,  -(mum2+mup1))
        mu3(2) = 0.0625d0 * fma(9.d0, mu0 +mup1, -(mum1+mup2))
        mu3(3) = 0.0625d0 * fma(9.d0, mup1+mup2, -(mu0 +mup3))
        Tm2 = T(i-2,j,k)
        Tm1 = T(i-1,j,k)
        T0  = T(i,  j,k)
        Tp1 = T(i+1,j,k)
        Tp2 = T(i+2,j,k)
        Tp3 = T(i+3,j,k)
        dxi = dx(i)
        block ! dQdx
          real(8) :: kTx3(3)
          kTx3(1) = Cp_over_Pr * mu3(1) * fma(1.125d0, T0 -Tm1, -one_24*(Tp1-Tm2)) * dxi
          kTx3(2) = Cp_over_Pr * mu3(2) * fma(1.125d0, Tp1-T0,  -one_24*(Tp2-Tm1)) * dxi
          kTx3(3) = Cp_over_Pr * mu3(3) * fma(1.125d0, Tp2-Tp1, -one_24*(Tp3-T0))  * dxi
          kTx     = flux4(kTx3(:))
        end block
        #:if is_les
        block
          real(8) :: H(4)
          H(:) = Cp * (/Tm1, T0, Tp1, Tp2/) + 0.5d0 * (u(idx-1:idx+2)**2 + v(idx-1:idx+2)**2 + w(idx-1:idx+2)**2) + qc2(i-1:i+2,j,k)
          Hsgs = -flux4(mut3) * (1.125d0 * (-H(2) + H(3)) - (-H(1) + H(4)) * one_24) * dxi / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu3, mut3, u(idx-2:idx+3), vy(idx-2:idx+3), wz(idx-2:idx+3), dxi, tau, utau)
          #:else
          call calc_tau_straight(mu3, u(idx-2:idx+3), vy(idx-2:idx+3), wz(idx-2:idx+3), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu3, mut3, v(idx-2:idx+3), uy(idx-2:idx+3), dxi, tau, utau)
          #:else
          call calc_tau_cross(mu3, v(idx-2:idx+3), uy(idx-2:idx+3), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu3, mut3, w(idx-2:idx+3), uz(idx-2:idx+3), dxi, tau, utau)
          #:else
          call calc_tau_cross(mu3, w(idx-2:idx+3), uz(idx-2:idx+3), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:else
    if (3 <= i .and. i <= nx-3 .and. 4 <= j .and. j <= ny-3 .and. 4 <= k .and. k <= nz-3) then
      block
        real(8) :: mu6(6), T6(6)
        real(8) :: dxi
        #:if is_les
        real(8) :: mut6(6)
        mut6(:) = mut(i-2:i+3, j, k)
        #:endif
        mu6(:) = mu(i-2:i+3, j, k)
        T6(:) = T(i-2:i+3, j, k)
        dxi = dx(i)
        kTx = Cp_over_Pr * interp6(mu6) * diff6(dxi, T6)
        #:if is_les
        block
          real(8) :: H(6)
          H(:) = Cp * T6(:) + 0.5d0 * (u(idx-2:idx+3)**2 + v(idx-2:idx+3)**2 + w(idx-2:idx+3)**2) + qc2(i-2:i+3,j,k)
          Hsgs = -interp6(mut6) * diff6(dxi, H) / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu6, mut6, u(idx-2:idx+3), vy(idx-2:idx+3), wz(idx-2:idx+3), dxi, tau, utau)
          #:else
          call calc_tau_straight(mu6, u(idx-2:idx+3), vy(idx-2:idx+3), wz(idx-2:idx+3), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu6, mut6, v(idx-2:idx+3), uy(idx-2:idx+3), dxi, tau, utau)
          #:else
          call calc_tau_cross(mu6, v(idx-2:idx+3), uy(idx-2:idx+3), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu6, mut6, w(idx-2:idx+3), uz(idx-2:idx+3), dxi, tau, utau)
          #:else
          call calc_tau_cross(mu6, w(idx-2:idx+3), uz(idx-2:idx+3), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:endif
    else
      block
        real(8) mx, mux, mvx, mwx, muy, mvy, muz, mwz
        real(8) mu_c, mu_e, dxi
        real(8) T_c, T_e
        #:if is_les
        real(8) mxsgs, muxsgs, mvxsgs, mwxsgs, muysgs, mvysgs, muzsgs, mwzsgs
        real(8) mut_c, mut_e
        mut_c   = mut(i,  j,k)
        mut_e   = mut(i+1,j,k)
        mxsgs    = 0.5d0 * (mut_c + mut_e)
        #:endif
        mu_c   = mu(i,  j,k)
        mu_e   = mu(i+1,j,k)
        mx       = 0.5d0 * (mu_c + mu_e)
        T_c = T(i,  j,k)
        T_e = T(i+1,j,k)
        dxi      = dx(i)
        kTx      = Cp_over_Pr * mx * (T_e - T_c) * dxi
        block
          real(8) :: my(2), dyj
          real(8) mu_cjm, mu_cjp, mu_ejm, mu_ejp
          #:if is_les
          real(8) mut_cjm, mut_cjp, mut_ejm, mut_ejp, mysgs(2)
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_cjm = __ldcs(mu(i,  j-1,k))
          mu_cjp = __ldcs(mu(i,  j+1,k))
          mu_ejm = __ldcs(mu(i+1,j-1,k))
          mu_ejp = __ldcs(mu(i+1,j+1,k))
          my(1) = 0.25d0 * (mu_cjm + mu_c + mu_ejm + mu_e)
          my(2) = 0.25d0 * (mu_c + mu_cjp + mu_e + mu_ejp)
          dyj = dy(j)
          muy = 0.25d0 * (my(1) * (-Q_2(i,j-1,k) + Q_2(i,j,k) - Q_2(i+1,j-1,k) + Q_2(i+1,j,k)) &
                        + my(2) * (-Q_2(i,j,k) + Q_2(i,j+1,k) - Q_2(i+1,j,k) + Q_2(i+1,j+1,k))) * dyj
          mvy = 0.25d0 * (my(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i+1,j-1,k) + Q_3(i+1,j,k)) &
                        + my(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i+1,j,k) + Q_3(i+1,j+1,k))) * dyj
          #:if is_les
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mut_cjm = __ldcs(mut(i,  j-1,k))
          mut_cjp = __ldcs(mut(i,  j+1,k))
          mut_ejm = __ldcs(mut(i+1,j-1,k))
          mut_ejp = __ldcs(mut(i+1,j+1,k))
          mysgs(:) = (/0.25d0 * (mut_cjm + mut_c + mut_ejm + mut_e), &
                       0.25d0 * (mut_c + mut_cjp + mut_e + mut_ejp)/)
          muysgs = 0.25d0 * (mysgs(1) * (-Q_2(i,j-1,k) + Q_2(i,j,k) - Q_2(i+1,j-1,k) + Q_2(i+1,j,k)) &
                           + mysgs(2) * (-Q_2(i,j,k) + Q_2(i,j+1,k) - Q_2(i+1,j,k) + Q_2(i+1,j+1,k))) * dyj
          mvysgs = 0.25d0 * (mysgs(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i+1,j-1,k) + Q_3(i+1,j,k)) &
                           + mysgs(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i+1,j,k) + Q_3(i+1,j+1,k))) * dyj
          #:endif
        end block
        block
          real(8) :: mz(2), dzk
          real(8) mu_ckm, mu_ckp, mu_ekm, mu_ekp
          #:if is_les
          real(8) mut_ckm, mut_ckp, mut_ekm, mut_ekp, mzsgs(2)
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_ckm = __ldcs(mu(i,  j,k-1))
          mu_ckp = __ldcs(mu(i,  j,k+1))
          mu_ekm = __ldcs(mu(i+1,j,k-1))
          mu_ekp = __ldcs(mu(i+1,j,k+1))
          mz(1) = 0.25d0 * (mu_ckm + mu_c + mu_ekm + mu_e)
          mz(2) = 0.25d0 * (mu_c + mu_ckp + mu_e + mu_ekp)
          dzk = dz(k)
          muz = 0.25d0 * (mz(1) * (-Q_2(i,j,k-1) + Q_2(i,j,k) - Q_2(i+1,j,k-1) + Q_2(i+1,j,k)) &
                        + mz(2) * (-Q_2(i,j,k) + Q_2(i,j,k+1) - Q_2(i+1,j,k) + Q_2(i+1,j,k+1))) * dzk
          mwz = 0.25d0 * (mz(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i+1,j,k-1) + Q_4(i+1,j,k)) &
                        + mz(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i+1,j,k) + Q_4(i+1,j,k+1))) * dzk
          #:if is_les
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mut_ckm = __ldcs(mut(i,  j,k-1))
          mut_ckp = __ldcs(mut(i,  j,k+1))
          mut_ekm = __ldcs(mut(i+1,j,k-1))
          mut_ekp = __ldcs(mut(i+1,j,k+1))
          mzsgs(:) = (/0.25d0 * (mut_ckm + mut_c + mut_ekm + mut_e), &
                       0.25d0 * (mut_c + mut_ckp + mut_e + mut_ekp)/)
          muzsgs = 0.25d0 * (mzsgs(1) * (-Q_2(i,j,k-1) + Q_2(i,j,k) - Q_2(i+1,j,k-1) + Q_2(i+1,j,k)) &
                           + mzsgs(2) * (-Q_2(i,j,k) + Q_2(i,j,k+1) - Q_2(i+1,j,k) + Q_2(i+1,j,k+1))) * dzk
          mwzsgs = 0.25d0 * (mzsgs(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i+1,j,k-1) + Q_4(i+1,j,k)) &
                           + mzsgs(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i+1,j,k) + Q_4(i+1,j,k+1))) * dzk
          #:endif
        end block
        mux  = mx * (-u(idx) + u(idx+1)) * dxi
        mvx  = mx * (-v(idx) + v(idx+1)) * dxi
        mwx  = mx * (-w(idx) + w(idx+1)) * dxi
        #:if is_les
        muxsgs = mxsgs * (-u(idx) + u(idx+1)) * dxi
        mvxsgs = mxsgs * (-v(idx) + v(idx+1)) * dxi
        mwxsgs = mxsgs * (-w(idx) + w(idx+1)) * dxi
        block
          real(8) :: H(2)
          H(:) = Cp * (/T_c, T_e/) + 0.5d0 * (u(idx:idx+1)**2 + v(idx:idx+1)**2 + w(idx:idx+1)**2) + qc2(i:i+1,j,k)
          Hsgs = -mxsgs * (-H(1) + H(2)) * dxi / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          tau  = two_third * fma(2.d0, mux, -(mvy + mwz))
          utau = 0.5d0 * (u(idx) + u(idx+1)) * tau
          #:if is_les
          tau = fma(two_third, fma(2.d0, muxsgs, -(mvysgs + mwzsgs)), tau)
          #:endif
          call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          tau  = muy + mvx
          utau = 0.5d0 * (v(idx) + v(idx+1)) * tau
          #:if is_les
          tau = tau + muysgs + mvxsgs
          #:endif
          call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          tau  = mwx + muz
          utau = 0.5d0 * (w(idx) + w(idx+1)) * tau
          #:if is_les
          tau = tau + mwxsgs + muzsgs
          #:endif
          call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    endif
    block
      real(8) :: e5v
      e5v = __ldlu(E(i,j-1,k-1,5))
      call __stcg(E(i,j-1,k-1,5), e5v - (utau_sum + kTx &
    #:if is_les
      + Hsgs &
    #:endif
      ))
    end block
  end subroutine calc_Ev${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Fv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    F)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsFv%x
    integer, parameter :: sy = threadsFv%y + 2*io_v + 1
    integer, parameter :: sz = threadsFv%z
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: ux
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vx
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vz
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wz
    integer i, j, k, it, jt, kt, jj, idx, offset_xz
    real(8) :: kTy, utau_sum
    real(8) :: dxi, dzk
    #:if is_les
    real(8) Hsgs
    #:endif
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_xz = (it-1)*sy + (kt-1)*sy*sx
    dxi = dx(i)
    dzk = dz(k)
    #:if VISC_ORDER == 4
    call load_smem_visc_cent4_y(it, jt, kt, i, k, nx, ny, nz, dxi, dzk, Q_2, Q_3, Q_4, u, v, w, ux, vx, vz, wz)
    #:elif VISC_STENCIL == 'ME4Base'
    call load_smem_visc_me4_base_y(it, jt, kt, i, k, nx, ny, nz, dxi, dzk, Q_2, Q_3, Q_4, u, v, w, ux, vx, vz, wz)
    #:else
    call load_smem_visc_cent6_y(it, jt, kt, i, k, nx, ny, nz, dxi, dzk, Q_2, Q_3, Q_4, u, v, w, ux, vx, vz, wz)
    #:endif
    j  = (blockIdx%y-1)*blockDim%y + jt
    idx = jt + offset_xz
    #:if is_koff
    if (nx-1 < i .or. ny-1 < j .or. k_hi < k) return
    #:else
    if (nx-1 < i .or. ny-1 < j .or. nz-1 < k) return
    #:endif
    #:if VISC_ORDER == 4
    if (3 <= i .and. i <= nx-2 .and. 2 <= j .and. j <= ny-2 .and. 3 <= k .and. k <= nz-2) then
      block
        real(8) :: mu4(4), T4(4)
        real(8) :: dyj
        #:if is_les
        real(8) :: mut4(4)
        mut4(:) = mut(i, j-1:j+2, k)
        #:endif
        mu4(:) = mu(i, j-1:j+2, k)
        T4(:) = T(i, j-1:j+2, k)
        dyj = dy(j)
        kTy = Cp_over_Pr * interp4(mu4) * diff4(dyj, T4)
        #:if is_les
        block
          real(8) :: H(4)
          H(:) = Cp * T4(:) + 0.5d0 * (u(idx-1:idx+2)**2 + v(idx-1:idx+2)**2 + w(idx-1:idx+2)**2) + qc2(i,j-1:j+2,k)
          Hsgs = -interp4(mut4) * diff4(dyj, H) / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu4, mut4, v(idx-1:idx+2), wz(idx-1:idx+2), ux(idx-1:idx+2), dyj, tau, utau)
          #:else
          call calc_tau_straight(mu4, v(idx-1:idx+2), wz(idx-1:idx+2), ux(idx-1:idx+2), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu4, mut4, u(idx-1:idx+2), vx(idx-1:idx+2), dyj, tau, utau)
          #:else
          call calc_tau_cross(mu4, u(idx-1:idx+2), vx(idx-1:idx+2), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu4, mut4, w(idx-1:idx+2), vz(idx-1:idx+2), dyj, tau, utau)
          #:else
          call calc_tau_cross(mu4, w(idx-1:idx+2), vz(idx-1:idx+2), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:elif VISC_STENCIL == 'ME4Base'
    if (3 <= i .and. i <= nx-2 .and. 3 <= j .and. j <= ny-3 .and. 3 <= k .and. k <= nz-2) then
      block
        real(8) :: mu3(3)
        real(8) :: mum2, mum1, mu0, mup1, mup2, mup3
        real(8) :: Tm2, Tm1, T0, Tp1, Tp2, Tp3
        real(8) :: dyj
        #:if is_les
        real(8) :: mut3(3)
        real(8) :: mutm2, mutm1, mut0, mutp1, mutp2, mutp3
        mutm2 = mut(i,j-2,k)
        mutm1 = mut(i,j-1,k)
        mut0  = mut(i,j,  k)
        mutp1 = mut(i,j+1,k)
        mutp2 = mut(i,j+2,k)
        mutp3 = mut(i,j+3,k)
        mut3(1) = 0.0625d0 * fma(9.d0, mutm1+mut0,  -(mutm2+mutp1))
        mut3(2) = 0.0625d0 * fma(9.d0, mut0 +mutp1, -(mutm1+mutp2))
        mut3(3) = 0.0625d0 * fma(9.d0, mutp1+mutp2, -(mut0 +mutp3))
        #:endif
        mum2 = mu(i,j-2,k)
        mum1 = mu(i,j-1,k)
        mu0  = mu(i,j,  k)
        mup1 = mu(i,j+1,k)
        mup2 = mu(i,j+2,k)
        mup3 = mu(i,j+3,k)
        mu3(1) = 0.0625d0 * fma(9.d0, mum1+mu0,  -(mum2+mup1))
        mu3(2) = 0.0625d0 * fma(9.d0, mu0 +mup1, -(mum1+mup2))
        mu3(3) = 0.0625d0 * fma(9.d0, mup1+mup2, -(mu0 +mup3))
        Tm2 = T(i,j-2,k)
        Tm1 = T(i,j-1,k)
        T0  = T(i,j,  k)
        Tp1 = T(i,j+1,k)
        Tp2 = T(i,j+2,k)
        Tp3 = T(i,j+3,k)
        dyj = dy(j)
        block ! dQdy
          real(8) :: kTy3(3)
          kTy3(1) = Cp_over_Pr * mu3(1) * fma(1.125d0, T0 -Tm1, -one_24*(Tp1-Tm2)) * dyj
          kTy3(2) = Cp_over_Pr * mu3(2) * fma(1.125d0, Tp1-T0,  -one_24*(Tp2-Tm1)) * dyj
          kTy3(3) = Cp_over_Pr * mu3(3) * fma(1.125d0, Tp2-Tp1, -one_24*(Tp3-T0))  * dyj
          kTy     = flux4(kTy3(:))
        end block
        #:if is_les
        block
          real(8) :: H(4)
          H(:) = Cp * (/Tm1, T0, Tp1, Tp2/) + 0.5d0 * (u(idx-1:idx+2)**2 + v(idx-1:idx+2)**2 + w(idx-1:idx+2)**2) + qc2(i,j-1:j+2,k)
          Hsgs = -flux4(mut3) * (1.125d0 * (-H(2) + H(3)) - (-H(1) + H(4)) * one_24) * dyj / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu3, mut3, v(idx-2:idx+3), wz(idx-2:idx+3), ux(idx-2:idx+3), dyj, tau, utau)
          #:else
          call calc_tau_straight(mu3, v(idx-2:idx+3), wz(idx-2:idx+3), ux(idx-2:idx+3), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu3, mut3, u(idx-2:idx+3), vx(idx-2:idx+3), dyj, tau, utau)
          #:else
          call calc_tau_cross(mu3, u(idx-2:idx+3), vx(idx-2:idx+3), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu3, mut3, w(idx-2:idx+3), vz(idx-2:idx+3), dyj, tau, utau)
          #:else
          call calc_tau_cross(mu3, w(idx-2:idx+3), vz(idx-2:idx+3), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:else
    if (4 <= i .and. i <= nx-3 .and. 3 <= j .and. j <= ny-3 .and. 4 <= k .and. k <= nz-3) then
      block
        real(8) :: mu6(6), T6(6)
        real(8) :: dyj
        #:if is_les
        real(8) :: mut6(6)
        mut6(:) = mut(i, j-2:j+3, k)
        #:endif
        mu6(:) = mu(i, j-2:j+3, k)
        T6(:) = T(i, j-2:j+3, k)
        dyj = dy(j)
        kTy = Cp_over_Pr * interp6(mu6) * diff6(dyj, T6)
        #:if is_les
        block
          real(8) :: H(6)
          H(:) = Cp * T6(:) + 0.5d0 * (u(idx-2:idx+3)**2 + v(idx-2:idx+3)**2 + w(idx-2:idx+3)**2) + qc2(i,j-2:j+3,k)
          Hsgs = -interp6(mut6) * diff6(dyj, H) / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu6, mut6, v(idx-2:idx+3), wz(idx-2:idx+3), ux(idx-2:idx+3), dyj, tau, utau)
          #:else
          call calc_tau_straight(mu6, v(idx-2:idx+3), wz(idx-2:idx+3), ux(idx-2:idx+3), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu6, mut6, u(idx-2:idx+3), vx(idx-2:idx+3), dyj, tau, utau)
          #:else
          call calc_tau_cross(mu6, u(idx-2:idx+3), vx(idx-2:idx+3), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu6, mut6, w(idx-2:idx+3), vz(idx-2:idx+3), dyj, tau, utau)
          #:else
          call calc_tau_cross(mu6, w(idx-2:idx+3), vz(idx-2:idx+3), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:endif
    else
      block
        real(8) my, muy, mvy, mwy, mvz, mwz, mux, mvx
        real(8) mu_c, mu_n
        real(8) T_c, T_n
        real(8) dyj
        #:if is_les
        real(8) mysgs, muysgs, mvysgs, mwysgs, mvzsgs, mwzsgs, muxsgs, mvxsgs
        real(8) mut_c, mut_n
        mut_c   = mut(i,  j,  k)
        mut_n   = mut(i,  j+1,k)
        mysgs    = 0.5d0 * (mut_c + mut_n)
        #:endif
        mu_c   = mu(i,  j,  k)
        mu_n   = mu(i,  j+1,k)
        my  = 0.5d0 * (mu_c + mu_n)
        T_c = T(i,j,  k)
        T_n = T(i,j+1,k)
        dyj = dy(j)
        kTy = Cp_over_Pr * my * (T_n - T_c) * dyj
        block
          real(8) :: mx(2)
          real(8) mu_wc, mu_wn, mu_ec, mu_en
          real(8) dxi
          #:if is_les
          real(8) mut_wc, mut_wn, mut_ec, mut_en, mxsgs(2)
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_wc  = __ldcs(mu(i-1,j,  k))
          mu_wn  = __ldcs(mu(i-1,j+1,k))
          mu_ec  = __ldcs(mu(i+1,j,  k))
          mu_en  = __ldcs(mu(i+1,j+1,k))
          mx(1)  = 0.25d0 * (mu_wc + mu_c + mu_wn + mu_n)
          mx(2)  = 0.25d0 * (mu_c + mu_ec + mu_n + mu_en)
          dxi    = dx(i)
          mux    = 0.25d0 * (mx(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j+1,k) + Q_2(i,j+1,k)) &
                            + mx(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j+1,k) + Q_2(i+1,j+1,k))) * dxi
          mvx    = 0.25d0 * (mx(1) * (-Q_3(i-1,j,k) + Q_3(i,j,k) - Q_3(i-1,j+1,k) + Q_3(i,j+1,k)) &
                            + mx(2) * (-Q_3(i,j,k) + Q_3(i+1,j,k) - Q_3(i,j+1,k) + Q_3(i+1,j+1,k))) * dxi
          #:if is_les
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mut_wc  = __ldcs(mut(i-1,j,  k))
          mut_wn  = __ldcs(mut(i-1,j+1,k))
          mut_ec  = __ldcs(mut(i+1,j,  k))
          mut_en  = __ldcs(mut(i+1,j+1,k))
          mxsgs(:) = (/0.25d0 * (mut_wc + mut_c + mut_wn + mut_n), &
                       0.25d0 * (mut_c + mut_ec + mut_n + mut_en)/)
          muxsgs = 0.25d0 * (mxsgs(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j+1,k) + Q_2(i,j+1,k)) &
                            + mxsgs(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j+1,k) + Q_2(i+1,j+1,k))) * dxi
          mvxsgs = 0.25d0 * (mxsgs(1) * (-Q_3(i-1,j,k) + Q_3(i,j,k) - Q_3(i-1,j+1,k) + Q_3(i,j+1,k)) &
                            + mxsgs(2) * (-Q_3(i,j,k) + Q_3(i+1,j,k) - Q_3(i,j+1,k) + Q_3(i+1,j+1,k))) * dxi
          #:endif
        end block
        block
          real(8) :: mz(2)
          real(8) mu_ckm, mu_ckp, mu_nkm, mu_nkp
          real(8) dzk
          #:if is_les
          real(8) mut_ckm, mut_ckp, mut_nkm, mut_nkp, mzsgs(2)
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_ckm = __ldcs(mu(i,  j,  k-1))
          mu_ckp = __ldcs(mu(i,  j,  k+1))
          mu_nkm = __ldcs(mu(i,  j+1,k-1))
          mu_nkp = __ldcs(mu(i,  j+1,k+1))
          mz(1)  = 0.25d0 * (mu_ckm + mu_c + mu_nkm + mu_n)
          mz(2)  = 0.25d0 * (mu_c + mu_ckp + mu_n + mu_nkp)
          dzk    = dz(k)
          mvz    = 0.25d0 * (mz(1) * (-Q_3(i,j,k-1) + Q_3(i,j,k) - Q_3(i,j+1,k-1) + Q_3(i,j+1,k)) &
                            + mz(2) * (-Q_3(i,j,k) + Q_3(i,j,k+1) - Q_3(i,j+1,k) + Q_3(i,j+1,k+1))) * dzk
          mwz    = 0.25d0 * (mz(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i,j+1,k-1) + Q_4(i,j+1,k)) &
                            + mz(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i,j+1,k) + Q_4(i,j+1,k+1))) * dzk
          #:if is_les
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mut_ckm = __ldcs(mut(i,  j,  k-1))
          mut_ckp = __ldcs(mut(i,  j,  k+1))
          mut_nkm = __ldcs(mut(i,  j+1,k-1))
          mut_nkp = __ldcs(mut(i,  j+1,k+1))
          mzsgs(:) = (/0.25d0 * (mut_ckm + mut_c + mut_nkm + mut_n), &
                       0.25d0 * (mut_c + mut_ckp + mut_n + mut_nkp)/)
          mvzsgs = 0.25d0 * (mzsgs(1) * (-Q_3(i,j,k-1) + Q_3(i,j,k) - Q_3(i,j+1,k-1) + Q_3(i,j+1,k)) &
                            + mzsgs(2) * (-Q_3(i,j,k) + Q_3(i,j,k+1) - Q_3(i,j+1,k) + Q_3(i,j+1,k+1))) * dzk
          mwzsgs = 0.25d0 * (mzsgs(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i,j+1,k-1) + Q_4(i,j+1,k)) &
                            + mzsgs(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i,j+1,k) + Q_4(i,j+1,k+1))) * dzk
          #:endif
        end block
        muy  = my * (-u(idx) + u(idx+1)) * dyj
        mvy  = my * (-v(idx) + v(idx+1)) * dyj
        mwy  = my * (-w(idx) + w(idx+1)) * dyj
        #:if is_les
        muysgs = mysgs * (-u(idx) + u(idx+1)) * dyj
        mvysgs = mysgs * (-v(idx) + v(idx+1)) * dyj
        mwysgs = mysgs * (-w(idx) + w(idx+1)) * dyj
        block
          real(8) :: H(2)
          H(:) = Cp * (/T_c, T_n/) + 0.5d0 * (u(idx:idx+1)**2 + v(idx:idx+1)**2 + w(idx:idx+1)**2) + qc2(i,j:j+1,k)
          Hsgs = -mysgs * (-H(1) + H(2)) * dyj / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          tau  = two_third * fma(2.d0, mvy, -(mwz + mux))
          utau = 0.5d0 * (v(idx) + v(idx+1)) * tau
          #:if is_les
          tau = fma(two_third, fma(2.d0, mvysgs, -(mwzsgs + muxsgs)), tau)
          #:endif
          call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          tau  = muy + mvx
          utau = 0.5d0 * (u(idx) + u(idx+1)) * tau
          #:if is_les
          tau = tau + muysgs + mvxsgs
          #:endif
          call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          tau  = mvz + mwy
          utau = 0.5d0 * (w(idx) + w(idx+1)) * tau
          #:if is_les
          tau = tau + mvzsgs + mwysgs
          #:endif
          call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    endif
    block
      real(8) :: f5v
      f5v = __ldlu(F(i-1,j,k-1,5))
      call __stcg(F(i-1,j,k-1,5), f5v - (utau_sum + kTy &
    #:if is_les
      + Hsgs &
    #:endif
      ))
    end block
  end subroutine calc_Fv${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Gv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    G)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsGv%x
    integer, parameter :: sy = threadsGv%y
    integer, parameter :: sz = threadsGv%z + 2*io_v + 1
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wx
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wy
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: ux
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vy
    integer i, j, k, it, jt, kt, kk, idx, offset_xy
    real(8) :: kTz, utau_sum
    real(8) :: dxi, dyj
    #:if is_les
    real(8) :: Hsgs
    #:endif
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    offset_xy = (jt-1)*sz + (it-1)*sz*sy
    dxi = dx(i)
    dyj = dy(j)
    #:if is_koff
    #:if VISC_ORDER == 4
    call load_smem_visc_cent4_z_koff(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, Q_4, u, v, w, ux, wx, vy, wy, k_lo)
    #:elif VISC_STENCIL == 'ME4Base'
    call load_smem_visc_me4_base_z_koff(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, Q_4, u, v, w, ux, wx, vy, wy, k_lo)
    #:else
    call load_smem_visc_cent6_z_koff(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, Q_4, u, v, w, ux, wx, vy, wy, k_lo)
    #:endif
    k  = (blockIdx%z-1)*blockDim%z + k_lo - 1 + kt
    if (nx-1 < i .or. ny-1 < j .or. k_hi < k) return
    #:else
    #:if VISC_ORDER == 4
    call load_smem_visc_cent4_z(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, Q_4, u, v, w, ux, wx, vy, wy)
    #:elif VISC_STENCIL == 'ME4Base'
    call load_smem_visc_me4_base_z(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, Q_4, u, v, w, ux, wx, vy, wy)
    #:else
    call load_smem_visc_cent6_z(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, Q_4, u, v, w, ux, wx, vy, wy)
    #:endif
    k  = (blockIdx%z-1)*blockDim%z + kt
    if (nx-1 < i .or. ny-1 < j .or. nz-1 < k) return
    #:endif
    idx = kt + offset_xy
    #:if VISC_ORDER == 4
    if (3 <= i .and. i <= nx-2 .and. 3 <= j .and. j <= ny-2 .and. 2 <= k .and. k <= nz-2) then
      block
        real(8) :: mu4(4), T4(4)
        real(8) :: dzk
        #:if is_les
        real(8) :: mut4(4)
        mut4(:) = mut(i, j, k-1:k+2)
        #:endif
        mu4(:) = mu(i, j, k-1:k+2)
        T4(:) = T(i, j, k-1:k+2)
        dzk = dz(k)
        kTz = Cp_over_Pr * interp4(mu4) * diff4(dzk, T4)
        #:if is_les
        block
          real(8) :: H(4)
          H(:) = Cp * T4(:) + 0.5d0 * (u(idx-1:idx+2)**2 + v(idx-1:idx+2)**2 + w(idx-1:idx+2)**2) + qc2(i,j,k-1:k+2)
          Hsgs = -interp4(mut4) * diff4(dzk, H) / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu4, mut4, w(idx-1:idx+2), ux(idx-1:idx+2), vy(idx-1:idx+2), dzk, tau, utau)
          #:else
          call calc_tau_straight(mu4, w(idx-1:idx+2), ux(idx-1:idx+2), vy(idx-1:idx+2), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu4, mut4, u(idx-1:idx+2), wx(idx-1:idx+2), dzk, tau, utau)
          #:else
          call calc_tau_cross(mu4, u(idx-1:idx+2), wx(idx-1:idx+2), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu4, mut4, v(idx-1:idx+2), wy(idx-1:idx+2), dzk, tau, utau)
          #:else
          call calc_tau_cross(mu4, v(idx-1:idx+2), wy(idx-1:idx+2), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:elif VISC_STENCIL == 'ME4Base'
    if (3 <= i .and. i <= nx-2 .and. 3 <= j .and. j <= ny-2 .and. 3 <= k .and. k <= nz-3) then
      block
        real(8) :: mu3(3)
        real(8) :: mum2, mum1, mu0, mup1, mup2, mup3
        real(8) :: Tm2, Tm1, T0, Tp1, Tp2, Tp3
        real(8) :: dzk
        #:if is_les
        real(8) :: mut3(3)
        real(8) :: mutm2, mutm1, mut0, mutp1, mutp2, mutp3
        mutm2 = mut(i,j,k-2)
        mutm1 = mut(i,j,k-1)
        mut0  = mut(i,j,k  )
        mutp1 = mut(i,j,k+1)
        mutp2 = mut(i,j,k+2)
        mutp3 = mut(i,j,k+3)
        mut3(1) = 0.0625d0 * fma(9.d0, mutm1+mut0,  -(mutm2+mutp1))
        mut3(2) = 0.0625d0 * fma(9.d0, mut0 +mutp1, -(mutm1+mutp2))
        mut3(3) = 0.0625d0 * fma(9.d0, mutp1+mutp2, -(mut0 +mutp3))
        #:endif
        mum2 = mu(i,j,k-2)
        mum1 = mu(i,j,k-1)
        mu0  = mu(i,j,k  )
        mup1 = mu(i,j,k+1)
        mup2 = mu(i,j,k+2)
        mup3 = mu(i,j,k+3)
        mu3(1) = 0.0625d0 * fma(9.d0, mum1+mu0,  -(mum2+mup1))
        mu3(2) = 0.0625d0 * fma(9.d0, mu0 +mup1, -(mum1+mup2))
        mu3(3) = 0.0625d0 * fma(9.d0, mup1+mup2, -(mu0 +mup3))
        Tm2 = T(i,j,k-2)
        Tm1 = T(i,j,k-1)
        T0  = T(i,j,k  )
        Tp1 = T(i,j,k+1)
        Tp2 = T(i,j,k+2)
        Tp3 = T(i,j,k+3)
        dzk = dz(k)
        block ! dQdz
          real(8) :: kTz3(3)
          kTz3(1) = Cp_over_Pr * mu3(1) * fma(1.125d0, T0 -Tm1, -one_24*(Tp1-Tm2)) * dzk
          kTz3(2) = Cp_over_Pr * mu3(2) * fma(1.125d0, Tp1-T0,  -one_24*(Tp2-Tm1)) * dzk
          kTz3(3) = Cp_over_Pr * mu3(3) * fma(1.125d0, Tp2-Tp1, -one_24*(Tp3-T0))  * dzk
          kTz     = flux4(kTz3(:))
        end block
        #:if is_les
        block
          real(8) :: H(4)
          H(:) = Cp * (/Tm1, T0, Tp1, Tp2/) + 0.5d0 * (u(idx-1:idx+2)**2 + v(idx-1:idx+2)**2 + w(idx-1:idx+2)**2) + qc2(i,j,k-1:k+2)
          Hsgs = -flux4(mut3) * (1.125d0 * (-H(2) + H(3)) - (-H(1) + H(4)) * one_24) * dzk / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu3, mut3, w(idx-2:idx+3), ux(idx-2:idx+3), vy(idx-2:idx+3), dzk, tau, utau)
          #:else
          call calc_tau_straight(mu3, w(idx-2:idx+3), ux(idx-2:idx+3), vy(idx-2:idx+3), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu3, mut3, u(idx-2:idx+3), wx(idx-2:idx+3), dzk, tau, utau)
          #:else
          call calc_tau_cross(mu3, u(idx-2:idx+3), wx(idx-2:idx+3), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu3, mut3, v(idx-2:idx+3), wy(idx-2:idx+3), dzk, tau, utau)
          #:else
          call calc_tau_cross(mu3, v(idx-2:idx+3), wy(idx-2:idx+3), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:else
    if (4 <= i .and. i <= nx-3 .and. 4 <= j .and. j <= ny-3 .and. 3 <= k .and. k <= nz-3) then
      block
        real(8) :: mu6(6), T6(6)
        real(8) :: dzk
        #:if is_les
        real(8) :: mut6(6)
        mut6(:) = mut(i, j, k-2:k+3)
        #:endif
        mu6(:) = mu(i, j, k-2:k+3)
        T6(:) = T(i, j, k-2:k+3)
        dzk = dz(k)
        kTz = Cp_over_Pr * interp6(mu6) * diff6(dzk, T6)
        #:if is_les
        block
          real(8) :: H(6)
          H(:) = Cp * T6(:) + 0.5d0 * (u(idx-2:idx+3)**2 + v(idx-2:idx+3)**2 + w(idx-2:idx+3)**2) + qc2(i,j,k-2:k+3)
          Hsgs = -interp6(mut6) * diff6(dzk, H) / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mu6, mut6, w(idx-2:idx+3), ux(idx-2:idx+3), vy(idx-2:idx+3), dzk, tau, utau)
          #:else
          call calc_tau_straight(mu6, w(idx-2:idx+3), ux(idx-2:idx+3), vy(idx-2:idx+3), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu6, mut6, u(idx-2:idx+3), wx(idx-2:idx+3), dzk, tau, utau)
          #:else
          call calc_tau_cross(mu6, u(idx-2:idx+3), wx(idx-2:idx+3), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_cross_LES(mu6, mut6, v(idx-2:idx+3), wy(idx-2:idx+3), dzk, tau, utau)
          #:else
          call calc_tau_cross(mu6, v(idx-2:idx+3), wy(idx-2:idx+3), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    #:endif
    else
      block
        real(8) mz, muz, mvz, mwz, mwx, mux, mvy, mwy
        real(8) mu_c, mu_t
        real(8) T_c, T_t
        real(8) dzk
        #:if is_les
        real(8) mzsgs, muzsgs, mvzsgs, mwzsgs, mwxsgs, muxsgs, mvysgs, mwysgs
        real(8) mut_c, mut_t
        mut_c  = mut(i,  j,  k)
        mut_t  = mut(i,  j,  k+1)
        mzsgs    = 0.5d0 * (mut_c + mut_t)
        #:endif
        !mu_c/mu_t = mu at (i,j,k)/(i,j,k+1)
        mu_c  = mu(i,  j,  k)
        mu_t  = mu(i,  j,  k+1)
        block
          real(8) :: mx(2)
          real(8) mu_wc, mu_wt, mu_ec, mu_et
          real(8) dxi
          #:if is_les
          real(8) mut_wc, mut_wt, mut_ec, mut_et, mxsgs(2)
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_wc = __ldcs(mu(i-1,j,  k))
          mu_wt = __ldcs(mu(i-1,j,  k+1))
          mu_ec = __ldcs(mu(i+1,j,  k))
          mu_et = __ldcs(mu(i+1,j,  k+1))
          mx(1) = 0.25d0 * (mu_wc + mu_c + mu_wt + mu_t)
          mx(2) = 0.25d0 * (mu_c + mu_ec + mu_t + mu_et)
          dxi = dx(i)
          mux = 0.25d0 * (mx(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j,k+1) + Q_2(i,j,k+1)) &
                        + mx(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j,k+1) + Q_2(i+1,j,k+1))) * dxi
          mwx = 0.25d0 * (mx(1) * (-Q_4(i-1,j,k) + Q_4(i,j,k) - Q_4(i-1,j,k+1) + Q_4(i,j,k+1)) &
                        + mx(2) * (-Q_4(i,j,k) + Q_4(i+1,j,k) - Q_4(i,j,k+1) + Q_4(i+1,j,k+1))) * dxi
          #:if is_les
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mut_wc = __ldcs(mut(i-1,j,  k))
          mut_wt = __ldcs(mut(i-1,j,  k+1))
          mut_ec = __ldcs(mut(i+1,j,  k))
          mut_et = __ldcs(mut(i+1,j,  k+1))
          mxsgs(:) = (/0.25d0 * (mut_wc + mut_c + mut_wt + mut_t), &
                       0.25d0 * (mut_c + mut_ec + mut_t + mut_et)/)
          muxsgs = 0.25d0 * (mxsgs(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j,k+1) + Q_2(i,j,k+1)) &
                            + mxsgs(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j,k+1) + Q_2(i+1,j,k+1))) * dxi
          mwxsgs = 0.25d0 * (mxsgs(1) * (-Q_4(i-1,j,k) + Q_4(i,j,k) - Q_4(i-1,j,k+1) + Q_4(i,j,k+1)) &
                            + mxsgs(2) * (-Q_4(i,j,k) + Q_4(i+1,j,k) - Q_4(i,j,k+1) + Q_4(i+1,j,k+1))) * dxi
          #:endif
        end block
        block
          real(8) :: my(2)
          real(8) mu_sc, mu_st, mu_nc, mu_nt
          real(8) dyj
          #:if is_les
          real(8) mut_sc, mut_st, mut_nc, mut_nt, mysgs(2)
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_sc = __ldcs(mu(i,  j-1,k))
          mu_st = __ldcs(mu(i,  j-1,k+1))
          mu_nc = __ldcs(mu(i,  j+1,k))
          mu_nt = __ldcs(mu(i,  j+1,k+1))
          my(1) = 0.25d0 * (mu_sc + mu_c + mu_st + mu_t)
          my(2) = 0.25d0 * (mu_c + mu_nc + mu_t + mu_nt)
          dyj = dy(j)
          mvy = 0.25d0 * (my(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i,j-1,k+1) + Q_3(i,j,k+1)) &
                        + my(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i,j,k+1) + Q_3(i,j+1,k+1))) * dyj
          mwy = 0.25d0 * (my(1) * (-Q_4(i,j-1,k) + Q_4(i,j,k) - Q_4(i,j-1,k+1) + Q_4(i,j,k+1)) &
                        + my(2) * (-Q_4(i,j,k) + Q_4(i,j+1,k) - Q_4(i,j,k+1) + Q_4(i,j+1,k+1))) * dyj
          #:if is_les
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mut_sc = __ldcs(mut(i,  j-1,k))
          mut_st = __ldcs(mut(i,  j-1,k+1))
          mut_nc = __ldcs(mut(i,  j+1,k))
          mut_nt = __ldcs(mut(i,  j+1,k+1))
          mysgs(:) = (/0.25d0 * (mut_sc + mut_c + mut_st + mut_t), &
                       0.25d0 * (mut_c + mut_nc + mut_t + mut_nt)/)
          mvysgs = 0.25d0 * (mysgs(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i,j-1,k+1) + Q_3(i,j,k+1)) &
                            + mysgs(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i,j,k+1) + Q_3(i,j+1,k+1))) * dyj
          mwysgs = 0.25d0 * (mysgs(1) * (-Q_4(i,j-1,k) + Q_4(i,j,k) - Q_4(i,j-1,k+1) + Q_4(i,j,k+1)) &
                            + mysgs(2) * (-Q_4(i,j,k) + Q_4(i,j+1,k) - Q_4(i,j,k+1) + Q_4(i,j+1,k+1))) * dyj
          #:endif
        end block
        mz   = 0.5d0 * (mu_c + mu_t)
        T_c = T(i,j,k  )
        T_t = T(i,j,k+1)
        dzk = dz(k)
        kTz  = Cp_over_Pr * mz * (T_t - T_c) * dzk
        muz  = mz * (-u(idx) + u(idx+1)) * dzk
        mvz  = mz * (-v(idx) + v(idx+1)) * dzk
        mwz  = mz * (-w(idx) + w(idx+1)) * dzk
        #:if is_les
        muzsgs = mzsgs * (-u(idx) + u(idx+1)) * dzk
        mvzsgs = mzsgs * (-v(idx) + v(idx+1)) * dzk
        mwzsgs = mzsgs * (-w(idx) + w(idx+1)) * dzk
        block
          real(8) :: H(2)
          H(:) = Cp * (/T_c, T_t/) + 0.5d0 * (u(idx:idx+1)**2 + v(idx:idx+1)**2 + w(idx:idx+1)**2) + qc2(i,j,k:k+1)
          Hsgs = -mzsgs * (-H(1) + H(2)) * dzk / Prt
        end block
        #:endif
        block
          real(8) :: tau, utau
          tau  = two_third * fma(2.d0, mwz, -(mux + mvy))
          utau = 0.5d0 * (w(idx) + w(idx+1)) * tau
          #:if is_les
          tau = fma(two_third, fma(2.d0, mwzsgs, -(muxsgs + mvysgs)), tau)
          #:endif
          call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
          utau_sum = utau
        end block
        block
          real(8) :: tau, utau
          tau  = mwx + muz
          utau = 0.5d0 * (u(idx) + u(idx+1)) * tau
          #:if is_les
          tau = tau + mwxsgs + muzsgs
          #:endif
          call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
          utau_sum = utau_sum + utau
        end block
        block
          real(8) :: tau, utau
          tau  = mvz + mwy
          utau = 0.5d0 * (v(idx) + v(idx+1)) * tau
          #:if is_les
          tau = tau + mvzsgs + mwysgs
          #:endif
          call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
          utau_sum = utau_sum + utau
        end block
      end block
    endif
    block
      real(8) :: g5v
      g5v = __ldlu(G(i-1,j-1,k,5))
      call __stcg(G(i-1,j-1,k,5), g5v - (utau_sum + kTz &
    #:if is_les
      + Hsgs &
    #:endif
      ))
    end block
  end subroutine calc_Gv${VISC_ORDER}$${suf}$
#:endfor
end module calc_visc_high
#:endif
