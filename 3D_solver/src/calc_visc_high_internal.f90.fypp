#:include 'config.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
#:set is_les = (VISC == 'LES')
#:set base_suf = "_in"
#:if VISC_ORDER == 2
module calc_visc_high_internal
end module calc_visc_high_internal
#:else
module calc_visc_high_internal
  use libm
  use mod_globals, only : gamma, R, Pr, Prt, dt, threadsEv, threadsFv, threadsGv
  use mod_constant, only : id_visc, Cp, gamma_1, Cp_over_Pr, one_third, two_third, one_twelfth
  use libm
  use load_smem_visc_cent${VISC_ORDER}$
  implicit none
  private
  public calc_Ev${VISC_ORDER}$_in, calc_Fv${VISC_ORDER}$_in, calc_Gv${VISC_ORDER}$_in, &
         calc_Ev${VISC_ORDER}$_in_koff, calc_Fv${VISC_ORDER}$_in_koff, calc_Gv${VISC_ORDER}$_in_koff
  real(8), parameter :: one_24 = 1.d0 / 24.d0
contains
  #:include 'calc_visc_cent.f90.fypp'

  ! See calc_visc_high.f90.fypp for the shared/register layout rationale
  ! (mu is never held in shared memory or a register array -- `mui` is
  ! computed once via scalar reads + interp${VISC_ORDER}$_s, reused across
  ! all 3 stages; likewise T uses diff${VISC_ORDER}$_s directly on scalar
  ! reads, never stored to a register array, which also avoids passing a
  ! non-contiguous y/z-direction slice into an array-argument dummy).
  ! This interior-only variant has no boundary fallback: `valid` gates
  ! whether this thread's (i,j,k) is in-array-bounds at all (an early
  ! `return` here would leave out-of-range threads never reaching the
  ! later stage2/stage3 syncthreads() calls that their still-running
  ! block-mates do reach, deadlocking the block), and threads outside the
  ! `interior` range simply skip all 3 stages' consumption blocks. The
  ! staged loads (and their syncthreads()) still run unconditionally for
  ! every thread in the block.

#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Ev${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    E)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsEv%x + 2*io_v + 1
    integer, parameter :: sy = threadsEv%y
    integer, parameter :: sz = threadsEv%z
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_a
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_b
    integer i, j, k, it, jt, kt, idx, offset_yz
    logical :: valid, interior
    real(8) :: kTx, utau_sum, dxi, dyj, dzk, mui
    #:if is_les
    real(8) Hsgs
    #:endif
    interior = .false.
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_yz = (jt-1)*sx + (kt-1)*sx*sy
    dyj = dy(j)
    dzk = dz(k)
    call load_smem_visc_cent${VISC_ORDER}$_x_uvw(it, jt, kt, j, k, nx, ny, nz, Q_2, Q_3, Q_4, u, v, w)
    call load_smem_visc_cent${VISC_ORDER}$_x_stage1(it, jt, kt, j, k, nx, ny, nz, dyj, dzk, Q_3, Q_4, grad_a, grad_b)
    i  = (blockIdx%x-1)*blockDim%x + it
    idx = it + offset_yz
    #:if is_koff
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    if (valid) then
      dxi = dx(i)
      interior = (io_v+1 <= i .and. i <= nx-io_v-1 .and. io_v+2 <= j .and. j <= ny-io_v-1 .and. io_v+2 <= k .and. k <= nz-io_v-1)
    endif

    ! ---- stage 1: straight component -> E(...,2) [uses u, grad_a=vy, grad_b=wz] ----
    if (valid .and. interior) then
      block
        real(8) :: Tx
        #:if is_les
        real(8) :: muti
        #:endif
        #:if VISC_ORDER == 4
        mui = interp${VISC_ORDER}$_s(mu(i-1,j,k), mu(i,j,k), mu(i+1,j,k), mu(i+2,j,k))
        Tx  = diff${VISC_ORDER}$_s(dxi, T(i-1,j,k), T(i,j,k), T(i+1,j,k), T(i+2,j,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i-1,j,k), mut(i,j,k), mut(i+1,j,k), mut(i+2,j,k))
        #:endif
        #:else
        mui = interp${VISC_ORDER}$_s(mu(i-2,j,k), mu(i-1,j,k), mu(i,j,k), mu(i+1,j,k), mu(i+2,j,k), mu(i+3,j,k))
        Tx  = diff${VISC_ORDER}$_s(dxi, T(i-2,j,k), T(i-1,j,k), T(i,j,k), T(i+1,j,k), T(i+2,j,k), T(i+3,j,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i-2,j,k), mut(i-1,j,k), mut(i,j,k), mut(i+1,j,k), mut(i+2,j,k), mut(i+3,j,k))
        #:endif
        #:endif
        kTx = Cp_over_Pr * mui * Tx
        #:if is_les
        block
          #:if VISC_ORDER == 4
          real(8) :: H_m1, H_0, H_p1, H_p2
          H_m1 = Cp*T(i-1,j,k) + 0.5d0*(u(idx-1)**2+v(idx-1)**2+w(idx-1)**2) + qc2(i-1,j,k)
          H_0  = Cp*T(i,  j,k) + 0.5d0*(u(idx  )**2+v(idx  )**2+w(idx  )**2) + qc2(i,  j,k)
          H_p1 = Cp*T(i+1,j,k) + 0.5d0*(u(idx+1)**2+v(idx+1)**2+w(idx+1)**2) + qc2(i+1,j,k)
          H_p2 = Cp*T(i+2,j,k) + 0.5d0*(u(idx+2)**2+v(idx+2)**2+w(idx+2)**2) + qc2(i+2,j,k)
          Hsgs = -muti * diff${VISC_ORDER}$_s(dxi, H_m1, H_0, H_p1, H_p2) / Prt
          #:else
          real(8) :: H_m2, H_m1, H_0, H_p1, H_p2, H_p3
          H_m2 = Cp*T(i-2,j,k) + 0.5d0*(u(idx-2)**2+v(idx-2)**2+w(idx-2)**2) + qc2(i-2,j,k)
          H_m1 = Cp*T(i-1,j,k) + 0.5d0*(u(idx-1)**2+v(idx-1)**2+w(idx-1)**2) + qc2(i-1,j,k)
          H_0  = Cp*T(i,  j,k) + 0.5d0*(u(idx  )**2+v(idx  )**2+w(idx  )**2) + qc2(i,  j,k)
          H_p1 = Cp*T(i+1,j,k) + 0.5d0*(u(idx+1)**2+v(idx+1)**2+w(idx+1)**2) + qc2(i+1,j,k)
          H_p2 = Cp*T(i+2,j,k) + 0.5d0*(u(idx+2)**2+v(idx+2)**2+w(idx+2)**2) + qc2(i+2,j,k)
          H_p3 = Cp*T(i+3,j,k) + 0.5d0*(u(idx+3)**2+v(idx+3)**2+w(idx+3)**2) + qc2(i+3,j,k)
          Hsgs = -muti * diff${VISC_ORDER}$_s(dxi, H_m2, H_m1, H_0, H_p1, H_p2, H_p3) / Prt
          #:endif
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mui, muti, u(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dxi, tau, utau)
          #:else
          call calc_tau_straight(mui, u(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dxi, tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
          utau_sum = utau
        end block
      end block
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_x_stage2(it, jt, kt, j, k, nx, ny, nz, dyj, Q_2, grad_a)

    ! ---- stage 2: cross component #1 -> E(...,3) [uses v, grad_a=uy] ----
    if (valid .and. interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, v(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dxi, tau, utau)
        #:else
        call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dxi, tau, utau)
        #:endif
        call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_x_stage3(it, jt, kt, j, k, nx, ny, nz, dzk, Q_2, grad_a)

    ! ---- stage 3: cross component #2 -> E(...,4) [uses w, grad_a=uz] ----
    if (valid .and. interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, w(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dxi, tau, utau)
        #:else
        call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dxi, tau, utau)
        #:endif
        call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(8) :: e5v
        e5v = __ldlu(E(i,j-1,k-1,5))
        call __stcg(E(i,j-1,k-1,5), e5v - (utau_sum + kTx &
    #:if is_les
      + Hsgs &
    #:endif
      ))
      end block
    endif
  end subroutine calc_Ev${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Fv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    F)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsFv%x
    integer, parameter :: sy = threadsFv%y + 2*io_v + 1
    integer, parameter :: sz = threadsFv%z
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_a
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_b
    integer i, j, k, it, jt, kt, idx, offset_xz
    logical :: valid, interior
    real(8) :: kTy, utau_sum, dxi, dyj, dzk, mui
    #:if is_les
    real(8) Hsgs
    #:endif
    interior = .false.
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_xz = (it-1)*sy + (kt-1)*sy*sx
    dxi = dx(i)
    dzk = dz(k)
    call load_smem_visc_cent${VISC_ORDER}$_y_uvw(it, jt, kt, i, k, nx, ny, nz, Q_2, Q_3, Q_4, u, v, w)
    call load_smem_visc_cent${VISC_ORDER}$_y_stage1(it, jt, kt, i, k, nx, ny, nz, dxi, dzk, Q_2, Q_4, grad_a, grad_b)
    j  = (blockIdx%y-1)*blockDim%y + jt
    idx = jt + offset_xz
    #:if is_koff
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    if (valid) then
      dyj = dy(j)
      interior = (io_v+2 <= i .and. i <= nx-io_v-1 .and. io_v+1 <= j .and. j <= ny-io_v-1 .and. io_v+2 <= k .and. k <= nz-io_v-1)
    endif

    ! ---- stage 1: straight component -> F(...,3) [uses v, grad_a=ux, grad_b=wz] ----
    if (valid .and. interior) then
      block
        real(8) :: Tx
        #:if is_les
        real(8) :: muti
        #:endif
        #:if VISC_ORDER == 4
        mui = interp${VISC_ORDER}$_s(mu(i,j-1,k), mu(i,j,k), mu(i,j+1,k), mu(i,j+2,k))
        Tx  = diff${VISC_ORDER}$_s(dyj, T(i,j-1,k), T(i,j,k), T(i,j+1,k), T(i,j+2,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j-1,k), mut(i,j,k), mut(i,j+1,k), mut(i,j+2,k))
        #:endif
        #:else
        mui = interp${VISC_ORDER}$_s(mu(i,j-2,k), mu(i,j-1,k), mu(i,j,k), mu(i,j+1,k), mu(i,j+2,k), mu(i,j+3,k))
        Tx  = diff${VISC_ORDER}$_s(dyj, T(i,j-2,k), T(i,j-1,k), T(i,j,k), T(i,j+1,k), T(i,j+2,k), T(i,j+3,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j-2,k), mut(i,j-1,k), mut(i,j,k), mut(i,j+1,k), mut(i,j+2,k), mut(i,j+3,k))
        #:endif
        #:endif
        kTy = Cp_over_Pr * mui * Tx
        #:if is_les
        block
          #:if VISC_ORDER == 4
          real(8) :: H_m1, H_0, H_p1, H_p2
          H_m1 = Cp*T(i,j-1,k) + 0.5d0*(u(idx-1)**2+v(idx-1)**2+w(idx-1)**2) + qc2(i,j-1,k)
          H_0  = Cp*T(i,j,  k) + 0.5d0*(u(idx  )**2+v(idx  )**2+w(idx  )**2) + qc2(i,j,  k)
          H_p1 = Cp*T(i,j+1,k) + 0.5d0*(u(idx+1)**2+v(idx+1)**2+w(idx+1)**2) + qc2(i,j+1,k)
          H_p2 = Cp*T(i,j+2,k) + 0.5d0*(u(idx+2)**2+v(idx+2)**2+w(idx+2)**2) + qc2(i,j+2,k)
          Hsgs = -muti * diff${VISC_ORDER}$_s(dyj, H_m1, H_0, H_p1, H_p2) / Prt
          #:else
          real(8) :: H_m2, H_m1, H_0, H_p1, H_p2, H_p3
          H_m2 = Cp*T(i,j-2,k) + 0.5d0*(u(idx-2)**2+v(idx-2)**2+w(idx-2)**2) + qc2(i,j-2,k)
          H_m1 = Cp*T(i,j-1,k) + 0.5d0*(u(idx-1)**2+v(idx-1)**2+w(idx-1)**2) + qc2(i,j-1,k)
          H_0  = Cp*T(i,j,  k) + 0.5d0*(u(idx  )**2+v(idx  )**2+w(idx  )**2) + qc2(i,j,  k)
          H_p1 = Cp*T(i,j+1,k) + 0.5d0*(u(idx+1)**2+v(idx+1)**2+w(idx+1)**2) + qc2(i,j+1,k)
          H_p2 = Cp*T(i,j+2,k) + 0.5d0*(u(idx+2)**2+v(idx+2)**2+w(idx+2)**2) + qc2(i,j+2,k)
          H_p3 = Cp*T(i,j+3,k) + 0.5d0*(u(idx+3)**2+v(idx+3)**2+w(idx+3)**2) + qc2(i,j+3,k)
          Hsgs = -muti * diff${VISC_ORDER}$_s(dyj, H_m2, H_m1, H_0, H_p1, H_p2, H_p3) / Prt
          #:endif
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mui, muti, v(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dyj, tau, utau)
          #:else
          call calc_tau_straight(mui, v(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dyj, tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
          utau_sum = utau
        end block
      end block
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_y_stage2(it, jt, kt, i, k, nx, ny, nz, dxi, Q_3, grad_a)

    ! ---- stage 2: cross component #1 -> F(...,2) [uses u, grad_a=vx] ----
    if (valid .and. interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, u(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dyj, tau, utau)
        #:else
        call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dyj, tau, utau)
        #:endif
        call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_y_stage3(it, jt, kt, i, k, nx, ny, nz, dzk, Q_3, grad_a)

    ! ---- stage 3: cross component #2 -> F(...,4) [uses w, grad_a=vz] ----
    if (valid .and. interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, w(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dyj, tau, utau)
        #:else
        call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dyj, tau, utau)
        #:endif
        call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(8) :: f5v
        f5v = __ldlu(F(i-1,j,k-1,5))
        call __stcg(F(i-1,j,k-1,5), f5v - (utau_sum + kTy &
    #:if is_les
      + Hsgs &
    #:endif
      ))
      end block
    endif
  end subroutine calc_Fv${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Gv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    G)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsGv%x
    integer, parameter :: sy = threadsGv%y
    integer, parameter :: sz = threadsGv%z + 2*io_v + 1
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_a
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_b
    integer i, j, k, it, jt, kt, idx, offset_xy
    logical :: valid, interior
    real(8) :: kTz, utau_sum, dxi, dyj, dzk, mui
    #:if is_les
    real(8) :: Hsgs
    #:endif
    interior = .false.
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    offset_xy = (jt-1)*sz + (it-1)*sz*sy
    dxi = dx(i)
    dyj = dy(j)
    #:if is_koff
    call load_smem_visc_cent${VISC_ORDER}$_z_koff_uvw(it, jt, kt, i, j, nx, ny, nz, Q_2, Q_3, Q_4, u, v, w, k_lo)
    call load_smem_visc_cent${VISC_ORDER}$_z_koff_stage1(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, grad_a, grad_b, k_lo)
    k  = (blockIdx%z-1)*blockDim%z + k_lo - 1 + kt
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    call load_smem_visc_cent${VISC_ORDER}$_z_uvw(it, jt, kt, i, j, nx, ny, nz, Q_2, Q_3, Q_4, u, v, w)
    call load_smem_visc_cent${VISC_ORDER}$_z_stage1(it, jt, kt, i, j, nx, ny, nz, dxi, dyj, Q_2, Q_3, grad_a, grad_b)
    k  = (blockIdx%z-1)*blockDim%z + kt
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    idx = kt + offset_xy
    if (valid) then
      dzk = dz(k)
      interior = (io_v+2 <= i .and. i <= nx-io_v-1 .and. io_v+2 <= j .and. j <= ny-io_v-1 .and. io_v+1 <= k .and. k <= nz-io_v-1)
    endif

    ! ---- stage 1: straight component -> G(...,4) [uses w, grad_a=ux, grad_b=vy] ----
    if (valid .and. interior) then
      block
        real(8) :: Tx
        #:if is_les
        real(8) :: muti
        #:endif
        #:if VISC_ORDER == 4
        mui = interp${VISC_ORDER}$_s(mu(i,j,k-1), mu(i,j,k), mu(i,j,k+1), mu(i,j,k+2))
        Tx  = diff${VISC_ORDER}$_s(dzk, T(i,j,k-1), T(i,j,k), T(i,j,k+1), T(i,j,k+2))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j,k-1), mut(i,j,k), mut(i,j,k+1), mut(i,j,k+2))
        #:endif
        #:else
        mui = interp${VISC_ORDER}$_s(mu(i,j,k-2), mu(i,j,k-1), mu(i,j,k), mu(i,j,k+1), mu(i,j,k+2), mu(i,j,k+3))
        Tx  = diff${VISC_ORDER}$_s(dzk, T(i,j,k-2), T(i,j,k-1), T(i,j,k), T(i,j,k+1), T(i,j,k+2), T(i,j,k+3))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j,k-2), mut(i,j,k-1), mut(i,j,k), mut(i,j,k+1), mut(i,j,k+2), mut(i,j,k+3))
        #:endif
        #:endif
        kTz = Cp_over_Pr * mui * Tx
        #:if is_les
        block
          #:if VISC_ORDER == 4
          real(8) :: H_m1, H_0, H_p1, H_p2
          H_m1 = Cp*T(i,j,k-1) + 0.5d0*(u(idx-1)**2+v(idx-1)**2+w(idx-1)**2) + qc2(i,j,k-1)
          H_0  = Cp*T(i,j,k  ) + 0.5d0*(u(idx  )**2+v(idx  )**2+w(idx  )**2) + qc2(i,j,k  )
          H_p1 = Cp*T(i,j,k+1) + 0.5d0*(u(idx+1)**2+v(idx+1)**2+w(idx+1)**2) + qc2(i,j,k+1)
          H_p2 = Cp*T(i,j,k+2) + 0.5d0*(u(idx+2)**2+v(idx+2)**2+w(idx+2)**2) + qc2(i,j,k+2)
          Hsgs = -muti * diff${VISC_ORDER}$_s(dzk, H_m1, H_0, H_p1, H_p2) / Prt
          #:else
          real(8) :: H_m2, H_m1, H_0, H_p1, H_p2, H_p3
          H_m2 = Cp*T(i,j,k-2) + 0.5d0*(u(idx-2)**2+v(idx-2)**2+w(idx-2)**2) + qc2(i,j,k-2)
          H_m1 = Cp*T(i,j,k-1) + 0.5d0*(u(idx-1)**2+v(idx-1)**2+w(idx-1)**2) + qc2(i,j,k-1)
          H_0  = Cp*T(i,j,k  ) + 0.5d0*(u(idx  )**2+v(idx  )**2+w(idx  )**2) + qc2(i,j,k  )
          H_p1 = Cp*T(i,j,k+1) + 0.5d0*(u(idx+1)**2+v(idx+1)**2+w(idx+1)**2) + qc2(i,j,k+1)
          H_p2 = Cp*T(i,j,k+2) + 0.5d0*(u(idx+2)**2+v(idx+2)**2+w(idx+2)**2) + qc2(i,j,k+2)
          H_p3 = Cp*T(i,j,k+3) + 0.5d0*(u(idx+3)**2+v(idx+3)**2+w(idx+3)**2) + qc2(i,j,k+3)
          Hsgs = -muti * diff${VISC_ORDER}$_s(dzk, H_m2, H_m1, H_0, H_p1, H_p2, H_p3) / Prt
          #:endif
        end block
        #:endif
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mui, muti, w(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dzk, tau, utau)
          #:else
          call calc_tau_straight(mui, w(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dzk, tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
          utau_sum = utau
        end block
      end block
    endif
    call syncthreads()
    #:if is_koff
    call load_smem_visc_cent${VISC_ORDER}$_z_koff_stage2(it, jt, kt, i, j, nx, ny, nz, dxi, Q_4, grad_a, k_lo)
    #:else
    call load_smem_visc_cent${VISC_ORDER}$_z_stage2(it, jt, kt, i, j, nx, ny, nz, dxi, Q_4, grad_a)
    #:endif

    ! ---- stage 2: cross component #1 -> G(...,2) [uses u, grad_a=wx] ----
    if (valid .and. interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, u(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dzk, tau, utau)
        #:else
        call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dzk, tau, utau)
        #:endif
        call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    call syncthreads()
    #:if is_koff
    call load_smem_visc_cent${VISC_ORDER}$_z_koff_stage3(it, jt, kt, i, j, nx, ny, nz, dyj, Q_4, grad_a, k_lo)
    #:else
    call load_smem_visc_cent${VISC_ORDER}$_z_stage3(it, jt, kt, i, j, nx, ny, nz, dyj, Q_4, grad_a)
    #:endif

    ! ---- stage 3: cross component #2 -> G(...,3) [uses v, grad_a=wy] ----
    if (valid .and. interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, v(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dzk, tau, utau)
        #:else
        call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dzk, tau, utau)
        #:endif
        call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(8) :: g5v
        g5v = __ldlu(G(i-1,j-1,k,5))
        call __stcg(G(i-1,j-1,k,5), g5v - (utau_sum + kTz &
    #:if is_les
      + Hsgs &
    #:endif
      ))
      end block
    endif
  end subroutine calc_Gv${VISC_ORDER}$${suf}$
#:endfor
end module calc_visc_high_internal
#:endif
