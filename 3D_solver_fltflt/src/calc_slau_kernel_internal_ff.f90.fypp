#:include 'config.fypp'
module calc_slau_kernel_internal
  use mod_globals, only : gamma, sp, threadsE, threadsF, threadsG
  use mod_constant, only : id_slau, over_gamma_1_ff, c0_25_ff, c0_5_ff, c1_ff, c2_ff, gamma_over_gamma_1_ff
  use calc_muscl
  use calc_hybrid
  use fltflt
  use cudadevice
  implicit none
  private
  public calc_slau_x_in, calc_slau_y_in, calc_slau_z_in
  include 'fltflt_operator_interfaces.f90'
  include 'fltflt_subroutines_interfaces.f90'
  integer, parameter :: io = ${ORDER_IO}$

#:if ORDER == 6
  integer(8), parameter :: id_acc = 0_8
#:elif ORDER == 4
  integer(4), parameter :: id_acc = 0_4
#:else
  integer(2), parameter :: id_acc = 0_2
#:endif

  interface interp
    module procedure interp2_ff, interp4_ff, interp6_ff
  end interface interp

  interface SLAU
    module procedure SLAU1_ff, HRSLAU2_ff
  end interface SLAU
contains
  include 'fltflt_operator.f90'
  include 'fltflt_subroutines.f90'
  include 'calc_slau_3d_ff.f90'

  ! fltflt (FP32-pair) interp family -- calc_slau_x_in/y_in/z_in all use
  ! fltflt shared memory, so interp2/4/6 are ff-only in this module (the
  ! real(8) originals live independently in calc_slau_kernel.f90.fypp,
  ! the non-tiled BC_X/Y/Z=True kernel file).
  attributes(device) subroutine interp6_ff(id_accuracy, rho, u, v, w, p, &
                                            rhol, ul, vl, wl, pl, &
                                            rhor, ur, vr, wr, pr, fd)
    integer(8), intent(in), value        :: id_accuracy
    type(fltflt), intent(in), contiguous :: rho(6), u(6), v(6), w(6), p(6)
    type(fltflt), intent(out)            :: rhol, ul, vl, wl, pl
    type(fltflt), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)              :: fd
    type(fltflt) :: fd_ff
    call delta6(fd, rho(:), rhol, rhor)
    call delta6(fd,   u(:),   ul,   ur)
    call delta6(fd,   v(:),   vl,   vr)
    call delta6(fd,   w(:),   wl,   wr)
    call delta6(fd,   p(:),   pl,   pr)
    fd_ff = wiggle_detector(p(2:5))
    fd = real(fd_ff%hi, 8) + real(fd_ff%lo, 8)
  end subroutine interp6_ff


  attributes(device) subroutine interp4_ff(id_accuracy, rho, u, v, w, p, &
                                            rhol, ul, vl, wl, pl, &
                                            rhor, ur, vr, wr, pr, fd)
    integer(4), intent(in), value        :: id_accuracy
    type(fltflt), intent(in), contiguous :: rho(4), u(4), v(4), w(4), p(4)
    type(fltflt), intent(out)            :: rhol, ul, vl, wl, pl
    type(fltflt), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)              :: fd
    type(fltflt) :: fd_ff
    call delta4(fd, rho(:), rhol, rhor)
    call delta4(fd,   u(:),   ul,   ur)
    call delta4(fd,   v(:),   vl,   vr)
    call delta4(fd,   w(:),   wl,   wr)
    call delta4(fd,   p(:),   pl,   pr)
    fd_ff = wiggle_detector(p(:))
    fd = real(fd_ff%hi, 8) + real(fd_ff%lo, 8)
  end subroutine interp4_ff


  attributes(device) subroutine interp2_ff(id_accuracy, rho, u, v, w, p, &
                                            rhol, ul, vl, wl, pl, &
                                            rhor, ur, vr, wr, pr, fd)
    integer(2), intent(in), value        :: id_accuracy
    type(fltflt), intent(in), contiguous :: rho(2), u(2), v(2), w(2), p(2)
    type(fltflt), intent(out)            :: rhol, ul, vl, wl, pl
    type(fltflt), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)              :: fd
    rhol = rho(1); rhor = rho(2)
      ul =   u(1);   ur =   u(2)
      vl =   v(1);   vr =   v(2)
      wl =   w(1);   wr =   w(2)
      pl =   p(1);   pr =   p(2)
      fd = 1.0_sp
  end subroutine interp2_ff


  attributes(global) subroutine calc_slau_x_in(nx, ny, nz, nbx, nby, nbz, Q, sensor, E)
    use mod_constant, only : Normal_x_ff
    integer, intent(in), value                :: nx, ny, nz, nbx, nby, nbz
    real(8), intent(in), device, contiguous   :: Q(nx,5,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: E(5,nx-1,ny-2,nz-2)
    integer i, j, k, it, jt, kt
    integer ii, i_base, idx, idx_r, offset_yz, offset_yzr, i1, i2
    integer :: tile, ntiles, bx, by, bz
    integer, parameter :: sx  = threadsE%x + 2*io + 1
    integer, parameter :: sxr = threadsE%x
    integer, parameter :: sy  = threadsE%y
    integer, parameter :: sz  = threadsE%z
    type(fltflt), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    type(fltflt), dimension(sxr*sy*sz), shared           :: rhor, ur, vr, wr, pr
    type(fltflt) rhol, ul, vl, wl, pl
    real(sp) fdx  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    ntiles = nbx * nby * nbz
    do tile = blockIdx%x, ntiles, gridDim%x
      bx = mod(tile-1, nbx) + 1
      by = mod((tile-1)/nbx, nby) + 1
      bz = (tile-1)/(nbx*nby) + 1
      j  = (by-1)*blockDim%y + jt + 1
      k  = (bz-1)*blockDim%z + kt + 1
      i_base     = (bx-1)*blockDim%x
      offset_yz  = (jt-1) * sx  + (kt-1) * sx  * sy
      offset_yzr = (jt-1) * sxr + (kt-1) * sxr * sy
      do ii = it-io, threadsE%x+io+1, blockDim%x
        i = i_base + ii
        if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
          idx = ii + offset_yz
          rho(idx) = fltflt_init(Q(i,1,j,k)); u(idx) = fltflt_init(Q(i,2,j,k)); v(idx) = fltflt_init(Q(i,3,j,k))
            w(idx) = fltflt_init(Q(i,4,j,k)); p(idx) = fltflt_init(Q(i,5,j,k))
        endif
      enddo
      call syncthreads()
      i = i_base + it
      if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
        idx   = it + offset_yz
        idx_r = it + offset_yzr
        i1    = idx - io
        i2    = idx + io + 1
        fdx   = 0.50_sp * (sensor(i,j,k) + sensor(i+1,j,k))
        call interp(id_acc, &
                    rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                    rhol,        ul,        vl,        wl,        pl, &
                    rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdx)
      endif
      call syncthreads()
      if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
        rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
        associate(un1 => u(idx), un2 => ur(idx_r))
          call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                    w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_x_ff, fdx, &
                    E(1,i,j-1,k-1), E(2,i,j-1,k-1), E(3,i,j-1,k-1), E(4,i,j-1,k-1), E(5,i,j-1,k-1))
        end associate
      endif
      call syncthreads()
    enddo
  end subroutine calc_slau_x_in


  attributes(global) subroutine calc_slau_y_in(nx, ny, nz, nbx, nby, nbz, Q, sensor, F)
    use mod_constant, only : Normal_y_ff
    integer, intent(in), value                :: nx, ny, nz, nbx, nby, nbz
    real(8), intent(in), device, contiguous   :: Q(nx,5,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: F(5,nx-2,ny-1,nz-2)
    integer i, j, k, it, jt, kt
    integer jj, j_base, idx, idx_r, offset_xz, offset_xzr, i1, i2
    integer :: tile, ntiles, bx, by, bz
    real(8) :: Fout(5)
    integer, parameter :: sx  = threadsF%x
    integer, parameter :: sy  = threadsF%y + 2*io + 1
    integer, parameter :: syr = threadsF%y
    integer, parameter :: sz  = threadsF%z
    type(fltflt), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    type(fltflt), dimension(sx*syr*sz), shared           :: rhor, ur, vr, wr, pr
    type(fltflt) rhol, ul, vl, wl, pl
    real(sp) fdy  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    ntiles = nbx * nby * nbz
    do tile = blockIdx%x, ntiles, gridDim%x
      bx = mod(tile-1, nbx) + 1
      by = mod((tile-1)/nbx, nby) + 1
      bz = (tile-1)/(nbx*nby) + 1
      i  = (bx-1)*blockDim%x + it + 1
      k  = (bz-1)*blockDim%z + kt + 1
      j_base     = (by-1)*blockDim%y
      offset_xz  = (it-1) * sy  + (kt-1) * sy  * sx
      offset_xzr = (it-1) * syr + (kt-1) * syr * sx
      do jj = jt-io, threadsF%y+io+1, blockDim%y
        j = j_base + jj
        if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
          idx = jj + offset_xz
          rho(idx) = fltflt_init(Q(i,1,j,k)); u(idx) = fltflt_init(Q(i,2,j,k)); v(idx) = fltflt_init(Q(i,3,j,k))
            w(idx) = fltflt_init(Q(i,4,j,k)); p(idx) = fltflt_init(Q(i,5,j,k))
        endif
      enddo
      call syncthreads()
      j = j_base + jt
      if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
        idx   = jt + offset_xz
        idx_r = jt + offset_xzr
        i1    = idx - io
        i2    = idx + io + 1
        fdy   = 0.50_sp * (sensor(i,j,k) + sensor(i,j+1,k))
        call interp(id_acc, &
                    rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                    rhol,        ul,        vl,        wl,        pl, &
                    rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdy)
      endif
      call syncthreads()
      if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
        rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
        associate(un1 => v(idx), un2 => vr(idx_r))
          call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                    w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_y_ff, fdy, &
                    Fout(1), Fout(2), Fout(3), Fout(4), Fout(5))
        end associate
        ! phase 2: F already holds phase-1's Fv (viscous) contribution -- accumulate.
        F(:,i-1,j,k-1) = F(:,i-1,j,k-1) + Fout(:)
      endif
      call syncthreads()
    enddo
  end subroutine calc_slau_y_in


  attributes(global) subroutine calc_slau_z_in(nx, ny, nz, nbx, nby, nbz, Q, sensor, G)
    use mod_constant, only : Normal_z_ff
    integer, intent(in), value                :: nx, ny, nz, nbx, nby, nbz
    real(8), intent(in), device, contiguous   :: Q(nx,5,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: G(5,nx-2,ny-2,nz-1)
    integer i, j, k, it, jt, kt
    integer kk, k_base, idx, idx_r, offset_xy, offset_xyr, i1, i2
    integer :: tile, ntiles, bx, by, bz
    real(8) :: Gout(5)
    integer, parameter :: sx  = threadsG%x
    integer, parameter :: sy  = threadsG%y
    integer, parameter :: sz  = threadsG%z + 2*io + 1
    integer, parameter :: szr = threadsG%z
    type(fltflt), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    type(fltflt), dimension(sx*sy*szr), shared           :: rhor, ur, vr, wr, pr
    type(fltflt) rhol, ul, vl, wl, pl
    real(sp) fdz  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    ntiles = nbx * nby * nbz
    do tile = blockIdx%x, ntiles, gridDim%x
      bx = mod(tile-1, nbx) + 1
      by = mod((tile-1)/nbx, nby) + 1
      bz = (tile-1)/(nbx*nby) + 1
      i  = (bx-1)*blockDim%x + it + 1
      j  = (by-1)*blockDim%y + jt + 1
      k_base     = (bz-1)*blockDim%z
      offset_xy  = (jt-1) * sz  + (it-1) * sz  * sy
      offset_xyr = (jt-1) * szr + (it-1) * szr * sy
      do kk = kt-io, threadsG%z+io+1, blockDim%z
        k = k_base + kk
        if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
          idx = kk + offset_xy
          rho(idx) = fltflt_init(Q(i,1,j,k)); u(idx) = fltflt_init(Q(i,2,j,k)); v(idx) = fltflt_init(Q(i,3,j,k))
            w(idx) = fltflt_init(Q(i,4,j,k)); p(idx) = fltflt_init(Q(i,5,j,k))
        endif
      enddo
      call syncthreads()
      k = k_base + kt
      if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
        idx   = kt + offset_xy
        idx_r = kt + offset_xyr
        i1    = idx - io
        i2    = idx + io + 1
        fdz   = 0.50_sp * (sensor(i,j,k) + sensor(i,j,k+1))
        call interp(id_acc, &
                    rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                    rhol,        ul,        vl,        wl,        pl, &
                    rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdz)
      endif
      call syncthreads()
      if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
        rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
        associate(un1 => w(idx), un2 => wr(idx_r))
          call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                    w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_z_ff, fdz, &
                    Gout(1), Gout(2), Gout(3), Gout(4), Gout(5))
        end associate
        ! phase 3: G already holds phase-2's Gv (viscous) contribution -- accumulate.
        G(:,i-1,j-1,k) = G(:,i-1,j-1,k) + Gout(:)
      endif
      call syncthreads()
    enddo
  end subroutine calc_slau_z_in


end module calc_slau_kernel_internal
