#:include 'config.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
module calc_flux_base
  use mod_globals, only : sp, &
  & blocks, threads, blocksE, blocksF, blocksG, threadsE, threadsF, threadsG, &
  & blocksEv, blocksFv, blocksGv, threadsEv, threadsFv, threadsGv
  use calc_physical_quantities
  use calc_hybrid
  use calc_keep_kernel_internal
  use calc_slau_kernel_internal
  use calc_hybrid_kernel
  use calc_hybrid_kernel_internal
  #:if VISC in ('NS', 'LES')
  use calc_visc2
  use calc_visc_high
  use calc_visc_high_internal
  #:endif
  use mod_streams, only : stream_conv, stream_visc, event_E, event_Fv, event_Gv, query_nblk
  use nvtx
  use set
  implicit none
  private
  public calc_EFG, init_sensor, init_occupancy
  #:if COMMZ
  public calc_EFG_halo
  #:endif
  integer, parameter :: io_fb      = ${ORDER_IO}$
  integer, parameter :: overlap_fb = ${ORDER_IO + 1}$
  real(sp), allocatable, device, save :: sensor(:,:,:)
  logical, save :: occupancy_initialized = .false.
  integer, save :: nblk_conv_E, nblk_conv_F, nblk_conv_G
  #:if VISC in ('NS', 'LES')
  integer, save :: nblk_visc_E, nblk_visc_F, nblk_visc_G
  #:endif
contains
  subroutine init_sensor(nx, ny, nz)
    integer, intent(in) :: nx, ny, nz
    allocate(sensor(nx,ny,nz))
  end subroutine init_sensor


  !> Query each convective/viscous kernel's true max resident blocks/SM
  !> (register + static-shared-memory footprint dependent) once at startup,
  !> replacing the flat SMs/2 guess with a properly occupancy-derived count.
  subroutine init_occupancy()
    #:set scheme_name = SCHEME.lower()
    integer :: istat, numBlocksPerSM
    if (occupancy_initialized) return
    istat = cudaOccupancyMaxActiveBlocksPerMultiprocessor(numBlocksPerSM, &
                calc_${scheme_name}$_x${'' if BC_X else '_in'}$, threadsE%x*threadsE%y*threadsE%z, 0)
    nblk_conv_E = query_nblk(numBlocksPerSM)
    istat = cudaOccupancyMaxActiveBlocksPerMultiprocessor(numBlocksPerSM, &
                calc_${scheme_name}$_y${'' if BC_Y else '_in'}$, threadsF%x*threadsF%y*threadsF%z, 0)
    nblk_conv_F = query_nblk(numBlocksPerSM)
    istat = cudaOccupancyMaxActiveBlocksPerMultiprocessor(numBlocksPerSM, &
                calc_${scheme_name}$_z${'' if BC_Z else '_in'}$, threadsG%x*threadsG%y*threadsG%z, 0)
    nblk_conv_G = query_nblk(numBlocksPerSM)
    print '(1x, a, 3(i0,1x))', "nblk_conv (E,F,G): ", nblk_conv_E, nblk_conv_F, nblk_conv_G
    #:if VISC in ('NS', 'LES')
    istat = cudaOccupancyMaxActiveBlocksPerMultiprocessor(numBlocksPerSM, &
                calc_Ev${VISC_ORDER}$_in, threadsEv%x*threadsEv%y*threadsEv%z, 0)
    nblk_visc_E = query_nblk(numBlocksPerSM)
    istat = cudaOccupancyMaxActiveBlocksPerMultiprocessor(numBlocksPerSM, &
                calc_Fv${VISC_ORDER}$_in, threadsFv%x*threadsFv%y*threadsFv%z, 0)
    nblk_visc_F = query_nblk(numBlocksPerSM)
    istat = cudaOccupancyMaxActiveBlocksPerMultiprocessor(numBlocksPerSM, &
                calc_Gv${VISC_ORDER}$_in, threadsGv%x*threadsGv%y*threadsGv%z, 0)
    nblk_visc_G = query_nblk(numBlocksPerSM)
    print '(1x, a, 3(i0,1x))', "nblk_visc (E,F,G): ", nblk_visc_E, nblk_visc_F, nblk_visc_G
    #:endif
    occupancy_initialized = .true.
  end subroutine init_occupancy


  subroutine calc_conv(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, E, F, G)
    integer, intent(in), value               :: nx, ny, nz
    real(8), intent(in), device, contiguous  :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous  :: Q(nx,5,ny,nz), T(nx,ny,nz)
    real(8), intent(out), device, contiguous :: E(5,nx-1,ny-2,nz-2)
    real(8), intent(out), device, contiguous :: F(5,nx-2,ny-1,nz-2)
    real(8), intent(out), device, contiguous :: G(5,nx-2,ny-2,nz-1)
    integer :: nbxE, nbyE, nbzE, nbxF, nbyF, nbzF, nbxG, nbyG, nbzG
    type(nvtxRangeId) :: id
    ! set fypp
    #:set scheme_name = SCHEME.lower()
    #:set args_t = ", T" if SCHEME in ('KEEP', 'Hybrid') else ""
    #:set args_sensor = ", sensor" if SCHEME in ('SLAU', 'Roe', 'Hybrid') else ""
    nbxE = blocksE%x; nbyE = blocksE%y; nbzE = blocksE%z
    nbxF = blocksF%x; nbyF = blocksF%y; nbzF = blocksF%z
    nbxG = blocksG%x; nbyG = blocksG%y; nbzG = blocksG%z
    ! shock sensor
    #:if SCHEME in ('SLAU', 'Roe', 'Hybrid')
    call calc_Ducros<<<blocks,threads,0,stream_conv>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, sensor)
    #:endif
    ! flux -- no viscous term to pair against for VISC == 'Euler': single stream,
    ! still occupancy-tiled so the launch pattern matches the NS/LES path.
    ! calc_*_y_in/calc_*_z_in accumulate onto F/G (`F = F + ...`) rather than
    ! overwrite -- a convention that only produces a valid result when a
    ! viscous kernel wrote a real baseline into F/G first (see
    ! calc_conv_visc_paired below). There is no such kernel on the Euler path,
    ! so zero F/G here first or the accumulate reads uninitialized device
    ! memory into the flux on every step (NaN/garbage almost immediately).
    call init_occupancy()
    F = 0.d0
    G = 0.d0
    id = nvtxRangeStart("E")
    call calc_${scheme_name}$_x${'' if BC_X else '_in'}$<<<dim3(nblk_conv_E,1,1),threadsE,0,stream_conv>>>&
         &(nx, ny, nz, nbxE, nbyE, nbzE, Q${args_t}$${args_sensor}$, E)
    call nvtxRangeEnd(id)
    id = nvtxRangeStart("F")
    call calc_${scheme_name}$_y${'' if BC_Y else '_in'}$<<<dim3(nblk_conv_F,1,1),threadsF,0,stream_conv>>>&
         &(nx, ny, nz, nbxF, nbyF, nbzF, Q${args_t}$${args_sensor}$, F)
    call nvtxRangeEnd(id)
    id = nvtxRangeStart("G")
    call calc_${scheme_name}$_z${'' if BC_Z else '_in'}$<<<dim3(nblk_conv_G,1,1),threadsG,0,stream_conv>>>&
         &(nx, ny, nz, nbxG, nbyG, nbzG, Q${args_t}$${args_sensor}$, G)
    call nvtxRangeEnd(id)
  end subroutine calc_conv


#:if VISC in ('NS', 'LES')
  #:set is_les   = (VISC == 'LES')
  #:set les_args = ', mut, qc2' if is_les else ''
  !> Interleaved convective (fltflt, stream_conv) / viscous (real8, stream_visc)
  !> dispatch. Buffers are staggered across phases so each phase's two kernels
  !> touch disjoint E/F/G slots and can run concurrently:
  !>   phase 1: E (conv, fresh write)   || Fv (visc, fresh write)
  !>   phase 2: F (conv, accumulates)   || Gv (visc, fresh write) -- waits on Fv
  !>   phase 3: G (conv, accumulates)   || Ev (visc, accumulates) -- wait on Gv, E
  subroutine calc_conv_visc_paired(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q(nx,5,ny,nz), T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz), qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(5,nx-1,ny-2,nz-2), F(5,nx-2,ny-1,nz-2)
    real(8), intent(inout), device, contiguous :: G(5,nx-2,ny-2,nz-1)
    integer :: nbxE, nbyE, nbzE, nbxF, nbyF, nbzF, nbxG, nbyG, nbzG
    integer :: nbxEv, nbyEv, nbzEv, nbxFv, nbyFv, nbzFv, nbxGv, nbyGv, nbzGv
    integer :: istat
    type(nvtxRangeId) :: id
    ! set fypp
    #:set scheme_name = SCHEME.lower()
    #:set args_t = ", T" if SCHEME in ('KEEP', 'Hybrid') else ""
    #:set args_sensor = ", sensor" if SCHEME in ('SLAU', 'Roe', 'Hybrid') else ""
    nbxE  = blocksE%x;  nbyE  = blocksE%y;  nbzE  = blocksE%z
    nbxF  = blocksF%x;  nbyF  = blocksF%y;  nbzF  = blocksF%z
    nbxG  = blocksG%x;  nbyG  = blocksG%y;  nbzG  = blocksG%z
    nbxEv = blocksEv%x; nbyEv = blocksEv%y; nbzEv = blocksEv%z
    nbxFv = blocksFv%x; nbyFv = blocksFv%y; nbzFv = blocksFv%z
    nbxGv = blocksGv%x; nbyGv = blocksGv%y; nbzGv = blocksGv%z
    ! Fv/Gv's fresh (non-koff) write only covers the range where their own
    ! cross-derivative stencil is valid (VISC_ORDER-wide halo in BOTH
    ! transverse directions, e.g. Fv needs 4<=i<=nx-3 AND 4<=k<=nz-3), which
    ! is narrower than the range the paired convective kernel accumulates
    ! into next (e.g. calc_*_y_in covers i<=nx-1, k<=nz-1). Without this,
    ! the boundary-shell cells Fv/Gv never touch are read (and accumulated
    ! onto) uninitialized -- zero them first so the convective accumulate
    ! sees a valid (viscous-free) baseline there instead of garbage.
    F = 0.d0
    G = 0.d0
    ! shock sensor (stream_conv; same-stream program order puts it before phase 1
    ! with no extra sync -- must NOT be the default stream, which would insert an
    ! implicit full-device barrier every RK stage and serialize stream_visc too)
    #:if SCHEME in ('SLAU', 'Roe', 'Hybrid')
    call calc_Ducros<<<blocks,threads,0,stream_conv>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, sensor)
    #:endif
    call init_occupancy()
    ! ---- phase 1: E (conv) || Fv (visc) ----
    id = nvtxRangeStart("E")
    call calc_${scheme_name}$_x_in<<<dim3(nblk_conv_E,1,1),threadsE,0,stream_conv>>>&
         &(nx, ny, nz, nbxE, nbyE, nbzE, Q${args_t}$${args_sensor}$, E)
    call nvtxRangeEnd(id)
    istat = cudaEventRecord(event_E, stream_conv)
    id = nvtxRangeStart("Fv")
    call calc_Fv${VISC_ORDER}$_in<<<dim3(nblk_visc_F,1,1),threadsFv,0,stream_visc>>>&
         &(nx, ny, nz, nbxFv, nbyFv, nbzFv, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$, F)
    call nvtxRangeEnd(id)
    istat = cudaEventRecord(event_Fv, stream_visc)
    ! ---- phase 2: F (conv, waits on Fv) || Gv (visc) ----
    istat = cudaStreamWaitEvent(stream_conv, event_Fv, 0)
    id = nvtxRangeStart("F")
    call calc_${scheme_name}$_y_in<<<dim3(nblk_conv_F,1,1),threadsF,0,stream_conv>>>&
         &(nx, ny, nz, nbxF, nbyF, nbzF, Q${args_t}$${args_sensor}$, F)
    call nvtxRangeEnd(id)
    id = nvtxRangeStart("Gv")
    call calc_Gv${VISC_ORDER}$_in<<<dim3(nblk_visc_G,1,1),threadsGv,0,stream_visc>>>&
         &(nx, ny, nz, nbxGv, nbyGv, nbzGv, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$, G)
    call nvtxRangeEnd(id)
    istat = cudaEventRecord(event_Gv, stream_visc)
    ! ---- phase 3: G (conv, waits on Gv) || Ev (visc, waits on E) ----
    istat = cudaStreamWaitEvent(stream_conv, event_Gv, 0)
    id = nvtxRangeStart("G")
    call calc_${scheme_name}$_z_in<<<dim3(nblk_conv_G,1,1),threadsG,0,stream_conv>>>&
         &(nx, ny, nz, nbxG, nbyG, nbzG, Q${args_t}$${args_sensor}$, G)
    call nvtxRangeEnd(id)
    istat = cudaStreamWaitEvent(stream_visc, event_E, 0)
    id = nvtxRangeStart("Ev")
    call calc_Ev${VISC_ORDER}$_in<<<dim3(nblk_visc_E,1,1),threadsEv,0,stream_visc>>>&
         &(nx, ny, nz, nbxEv, nbyEv, nbzEv, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$, E)
    call nvtxRangeEnd(id)
  end subroutine calc_conv_visc_paired
#:endif


#:if COMMZ
  subroutine calc_conv_EF(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, E, F)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q(nx,5,ny,nz), T(nx,ny,nz)
    real(8), intent(out), device, contiguous   :: E(5,nx-1,ny-2,nz-2)
    real(8), intent(out), device, contiguous   :: F(5,nx-2,ny-1,nz-2)
    ! set fypp
    #:set scheme_name = SCHEME.lower()
    #:set args_t = ", T" if SCHEME in ('KEEP', 'Hybrid') else ""
    #:set args_sensor = ", sensor" if SCHEME in ('SLAU', 'Roe', 'Hybrid') else ""
    ! shock sensor
    #:if SCHEME in ('SLAU', 'Roe', 'Hybrid')
    call calc_Ducros<<<blocks,threads,0,stream_conv>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, sensor)
    #:endif
    ! flux
    call calc_${scheme_name}$_x${'' if BC_X else '_in'}$<<<blocksE,threadsE>>>(nx, ny, nz, Q${args_t}$${args_sensor}$, E)
    call calc_${scheme_name}$_y${'' if BC_Y else '_in'}$<<<blocksF,threadsF>>>(nx, ny, nz, Q${args_t}$${args_sensor}$, F)
  end subroutine calc_conv_EF


  subroutine calc_conv_G_koff(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, G, k_lo, k_hi)
    integer, intent(in), value                 :: nx, ny, nz, k_lo, k_hi
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q(nx,5,ny,nz), T(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: G(5,nx-2,ny-2,nz-1)
    integer :: n_G
    type(dim3) :: bG
    n_G = k_hi - k_lo + 1
    bG = dim3(blocksG%x, blocksG%y, (n_G + threadsG%z - 1) / threadsG%z)
    ! set fypp
    #:set scheme_name = SCHEME.lower()
    #:set args_t = ", T" if SCHEME in ('KEEP', 'Hybrid') else ""
    #:set args_sensor = ", sensor" if SCHEME in ('SLAU', 'Roe', 'Hybrid') else ""
    ! shock sensor
    #:if SCHEME in ('SLAU', 'Roe', 'Hybrid')
    call calc_Ducros<<<blocks,threads,0,stream_conv>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, sensor)
    #:endif
    call calc_${scheme_name}$_z_in_koff<<<bG,threadsG>>>(nx, ny, nz, Q${args_t}$${args_sensor}$, G, k_lo, k_hi)
  end subroutine calc_conv_G_koff
#:endif


  subroutine calc_EFG(nx, ny, nz, inv_dx, inv_dy, inv_dz, Jacobian, QJ, Q, T, mu, mut, qc2, E, F, G, k_lo_G, k_hi_G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Jacobian(nx,ny), QJ(nx,5,ny,nz)
    real(8), intent(inout), device, contiguous :: Q(nx,5,ny,nz), T(nx,ny,nz)
    #:if VISC == 'Euler'
    real(8), intent(inout), device, contiguous :: mu(1,1,1), mut(1,1,1), qc2(1,1,1)
    #:elif VISC == 'NS'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: mut(1,1,1), qc2(1,1,1)
    #:elif VISC == 'LES'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz), mut(nx,ny,nz), qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(5,nx-1,ny-2,nz-2), F(5,nx-2,ny-1,nz-2)
    real(8), intent(inout), device, contiguous :: G(5,nx-2,ny-2,nz-1)
    integer, intent(in)                        :: k_lo_G, k_hi_G
    #:if VISC == 'NS' or VISC == 'LES'
    type(dim3) :: blocksGv_int, blocksEv_int, blocksFv_int
    integer :: n_int_Gv, n_int_Ev
    #:endif
    ! ===================================================================
    ! main part (Euler)
    ! ===================================================================
  #:if VISC == 'Euler'
    call calc_quantities_3D(nx, ny, nz, Jacobian, QJ, Q, T, 1, nz)
    #:if not COMMZ
      call calc_conv(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, E, F, G)
    #:else
      call calc_conv_EF(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, E, F)
      call calc_conv_G_koff(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, G, k_lo_G, k_hi_G)
    #:endif
  #:else
    ! ===================================================================
    ! NS and LES
    ! ===================================================================
    #:set is_les   = (VISC == 'LES')
    #:set les_args = ', mut, qc2' if is_les else ''
    ! ===================================================================
    ! axis
    ! ===================================================================
    #:set dirs = [ &
      {'dir': 'E', 'is_bc': BC_X, 'ov': 'overlap_fb+2'}, &
      {'dir': 'F', 'is_bc': BC_Y, 'ov': 'overlap_fb+2'}, &
      {'dir': 'G', 'is_bc': BC_Z, 'ov': 'overlap_fb+1'} &
    ]
    #:if is_les
    mut = 0.d0
    qc2 = 0.d0
    #:endif
    ! ===================================================================
    ! main part (NS and LES)
    ! ===================================================================
    call calc_quantities_T_3D(nx, ny, nz, Jacobian, QJ, Q, T, mu, 1, nz)
    ! ===================================================================
    ! whole domain or koff
    ! ===================================================================
    #:if not COMMZ
      #:if is_les
      call calc_mut<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, mut, qc2)
      call set_bc_mut(nx, ny, nz, mut, qc2)
      #:endif
      call calc_conv_visc_paired(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$, E, F, G)
    #:else
      call calc_conv_EF(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, E, F)
      call calc_conv_G_koff(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, G, k_lo_G, k_hi_G)
      #:if is_les
      call calc_mut<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, mut, qc2)
      call set_bc_mut(nx, ny, nz, mut, qc2)
      #:endif

      n_int_Ev = nz - 2*overlap_fb - 2
      n_int_Gv = nz - 2*overlap_fb - 1
      blocksEv_int = dim3(blocksEv%x, blocksEv%y, (n_int_Ev + threadsEv%z - 1) / threadsEv%z)
      blocksFv_int = dim3(blocksFv%x, blocksFv%y, (n_int_Ev + threadsFv%z - 1) / threadsFv%z)
      blocksGv_int = dim3(blocksGv%x, blocksGv%y, (n_int_Gv + threadsGv%z - 1) / threadsGv%z)

      #:for d in dirs
      #:set in_sfx = '_in' if (not d['is_bc'] and ORDER == 6) else ''
      call calc_${d['dir']}$v${VISC_ORDER}$_koff${in_sfx}$<<<blocks${d['dir']}$v,threads${d['dir']}$v>>>&           ! exchange "${in_sfx}$" and " _koff "
           &(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$,  ${d['ov']}$, nz-overlap_fb-1, ${d['dir']}$) ! moved "${d['dir']}$" 
      #:endfor
    #:endif
  #:endif
  end subroutine calc_EFG


#:if COMMZ
  subroutine calc_EFG_halo(nx, ny, nz, inv_dx, inv_dy, inv_dz, &
                             Jacobian, QJ, Q, T, mu, mut, qc2, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Jacobian(nx,ny), QJ(nx,5,ny,nz)
    real(8), intent(inout), device, contiguous :: Q(nx,5,ny,nz), T(nx,ny,nz)
    #:if VISC == 'Euler'
    real(8), intent(inout), device, contiguous :: mu(1,1,1), mut(1,1,1), qc2(1,1,1)
    #:elif VISC == 'NS'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: mut(1,1,1), qc2(1,1,1)
    #:elif VISC == 'LES'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz), mut(nx,ny,nz), qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(5,nx-1,ny-2,nz-2)
    real(8), intent(inout), device, contiguous :: F(5,nx-2,ny-1,nz-2)
    real(8), intent(inout), device, contiguous :: G(5,nx-2,ny-2,nz-1)
    #:if VISC == 'NS' or VISC == 'LES'
    type(dim3) :: blocksGv_halo, blocksEv_halo, blocksFv_halo
    integer :: n_halo
    #:endif
    ! ===================================================================
    ! main part (Euler)
    ! ===================================================================
  #:if VISC == 'Euler'
    call calc_quantities_3D(nx, ny, nz, Jacobian, QJ, Q, T, 1, overlap_fb)
    call calc_quantities_3D(nx, ny, nz, Jacobian, QJ, Q, T, nz-overlap_fb+1, nz)
    call calc_conv_G_koff(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, G, overlap_fb, 2*overlap_fb-1)
    call calc_conv_G_koff(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, G, nz-2*overlap_fb+1, nz-overlap_fb)
  #:else
    ! ===================================================================
    ! NS and LES
    ! ===================================================================
    #:set is_les   = (VISC == 'LES')
    #:set les_args = ', mut, qc2' if is_les else ''
    ! ===================================================================
    ! axis
    ! ===================================================================
    #:set dirs = [ &
      {'dir': 'E', 'is_bc': BC_X, 'has_in': True,  'b_lo': ('2', 'overlap_fb+1'), 'b_hi': ('nz-overlap_fb', 'nz-1')}, &
      {'dir': 'F', 'is_bc': BC_Y, 'has_in': True,  'b_lo': ('2', 'overlap_fb+1'), 'b_hi': ('nz-overlap_fb', 'nz-1')}, &
      {'dir': 'G', 'is_bc': BC_Z, 'has_in': False, 'b_lo': ('overlap_fb', '2*overlap_fb-1') &
      if (is_les and ORDER < 4) else ('1', 'overlap_fb'), 'b_hi': ('nz-overlap_fb', 'nz-1')} &
    ]
    call calc_quantities_T_3D(nx, ny, nz, Jacobian, QJ, Q, T, mu, 1, overlap_fb)
    call calc_quantities_T_3D(nx, ny, nz, Jacobian, QJ, Q, T, mu, nz-overlap_fb+1, nz)
    n_halo = overlap_fb
    blocksEv_halo = dim3(blocksEv%x, blocksEv%y, (n_halo + threadsEv%z - 1) / threadsEv%z)
    blocksFv_halo = dim3(blocksFv%x, blocksFv%y, (n_halo + threadsFv%z - 1) / threadsFv%z)
    blocksGv_halo = dim3(blocksGv%x, blocksGv%y, (n_halo + threadsGv%z - 1) / threadsGv%z)
    call calc_conv_G_koff(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, G, overlap_fb, 2*overlap_fb-1)
    call calc_conv_G_koff(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, G, nz-2*overlap_fb+1, nz-overlap_fb)

    #:for d in dirs
    #:set in_sfx = '_in' if (d['has_in'] and not d['is_bc'] and ORDER == 6) else ''
    ! Low-index side
    call calc_${d['dir']}$v${VISC_ORDER}$_koff${in_sfx}$<<<blocks${d['dir']}$v,threads${d['dir']}$v>>>&          ! exchange ${in_sfx}$ and _koff
           &(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$,  ${d['b_lo'][0]}$, ${d['b_lo'][1]}$ , ${d['dir']}$) ! moved "${d['dir']}$"
    ! High-index side
    call calc_${d['dir']}$v${VISC_ORDER}$_koff${in_sfx}$<<<blocks${d['dir']}$v,threads${d['dir']}$v>>>&           ! exchange ${in_sfx}$ and _koff
           &(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q, T, mu${les_args}$, ${d['b_hi'][0]}$, ${d['b_hi'][1]}$ , ${d['dir']}$)  ! moved "${d['dir']}$"
    #:endfor
  #:endif
  end subroutine calc_EFG_halo
#:endif
end module calc_flux_base
