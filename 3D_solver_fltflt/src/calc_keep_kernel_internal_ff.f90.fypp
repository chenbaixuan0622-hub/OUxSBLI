#:include 'config.fypp'
module calc_keep_kernel_internal
  use mod_globals, only : threadsE, threadsF, threadsG
  use mod_constant, only : R_over_gamma_1_ff, one_third_ff, one_sixth_ff, one_twelfth_ff, two_third_ff, &
                           c0_25_ff, c0_5_ff, &
                           c0_375_ff, c0_075_ff, c0_1875_ff, c0_0375_ff, c8_ff, c37_ff, c0_75_ff, c0_15_ff
  use fltflt
  implicit none
  private
  public calc_keep_x_in, calc_keep_y_in, calc_keep_z_in, init_keep_ff_constants
  ! No compile-time initializer: nvfortran doesn't support a type(fltflt)
  ! PARAMETER (or a `constant` with a compile-time initializer) computed from
  ! an expression -- confirmed by direct test ("Too few data constants in
  ! initialization statement"), even for a pure real(8) literal expression
  ! like `1.d0/24.d0`. Set once at startup by init_keep_ff_constants below via
  ! fltflt_init (host+device callable), called from init_streams
  ! (mod_streams.f90) before any kernel runs -- same pattern as
  ! mod_constant.f90.fypp's init_fltflt_constants.
  type(fltflt), constant :: one_24, one_48, one_60, one_120, one_240, seven_twelfth
  integer, parameter :: io = ${ORDER_IO}$

#:if ORDER == 6
  integer(8), parameter :: id_acc = 0_8
#:elif ORDER == 4
  integer(4), parameter :: id_acc = 0_4
#:else
  integer(2), parameter :: id_acc = 0_2
#:endif

  interface KEEP
    module procedure KEEP2_ff, KEEP4_ff, KEEP6_ff
  end interface KEEP
contains
  subroutine init_keep_ff_constants()
    one_24        = fltflt_init(1.d0 / 24.d0)
    one_48        = fltflt_init(1.d0 / 48.d0)
    one_60        = fltflt_init(1.d0 / 60.d0)
    one_120       = fltflt_init(1.d0 / 120.d0)
    one_240       = fltflt_init(1.d0 / 240.d0)
    seven_twelfth = fltflt_init(7.d0 / 12.d0)
  end subroutine init_keep_ff_constants

  include 'calc_keep_3d_ff.f90'

  attributes(global) subroutine calc_keep_x_in(nx, ny, nz, nbx, nby, nbz, Q, T, E)
    use mod_constant, only : Normal_x_ff
    integer, intent(in), value                :: nx, ny, nz, nbx, nby, nbz
    real(8), intent(in), device, contiguous   :: Q(nx,5,ny,nz), T(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: E(5,nx-1,ny-2,nz-2)
    integer i, j, k, it, jt, kt
    integer :: ii, i_base, idx, offset_yz
    integer :: tile, ntiles, bx, by, bz
    integer, parameter :: sx = threadsE%x + 2*io + 1
    integer, parameter :: sy = threadsE%y
    integer, parameter :: sz = threadsE%z
    type(fltflt), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    ntiles = nbx * nby * nbz
    do tile = blockIdx%x, ntiles, gridDim%x
      bx = mod(tile-1, nbx) + 1
      by = mod((tile-1)/nbx, nby) + 1
      bz = (tile-1)/(nbx*nby) + 1
      j  = (by-1)*blockDim%y + jt + 1
      k  = (bz-1)*blockDim%z + kt + 1
      i_base = (bx-1)*blockDim%x
      offset_yz = (jt-1) * sx + (kt-1) * sx * sy
      do ii = it-io, threadsE%x+io+1, blockDim%x
        i = i_base + ii
        if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
          idx = ii + offset_yz
          rho(idx) = fltflt_init(Q(i,1,j,k));   u(idx) = fltflt_init(Q(i,2,j,k))
            v(idx) = fltflt_init(Q(i,3,j,k));   w(idx) = fltflt_init(Q(i,4,j,k))
            p(idx) = fltflt_init(Q(i,5,j,k)); tmp(idx) = fltflt_init(T(i,j,k))
        endif
      enddo
      call syncthreads()
      i = i_base + it
      if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
        idx = it + offset_yz
        E(:,i,j-1,k-1) = KEEP(id_acc, &
                              rho(idx-io:idx+io+1), u(idx-io:idx+io+1), &
                                v(idx-io:idx+io+1), w(idx-io:idx+io+1), &
                               u(idx-io:idx+io+1), p(idx-io:idx+io+1), &
                              tmp(idx-io:idx+io+1), Normal_x_ff)
      endif
      call syncthreads()
    enddo
  end subroutine calc_keep_x_in


  attributes(global) subroutine calc_keep_y_in(nx, ny, nz, nbx, nby, nbz, Q, T, F)
    use mod_constant, only : Normal_y_ff
    integer, intent(in), value                :: nx, ny, nz, nbx, nby, nbz
    real(8), intent(in), device, contiguous   :: Q(nx,5,ny,nz), T(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: F(5,nx-2,ny-1,nz-2)
    integer i, j, k, it, jt, kt
    integer :: jj, j_base, idx, offset_xz
    integer :: tile, ntiles, bx, by, bz
    integer, parameter :: sx = threadsF%x
    integer, parameter :: sy = threadsF%y + 2*io + 1
    integer, parameter :: sz = threadsF%z
    type(fltflt), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    ntiles = nbx * nby * nbz
    do tile = blockIdx%x, ntiles, gridDim%x
      bx = mod(tile-1, nbx) + 1
      by = mod((tile-1)/nbx, nby) + 1
      bz = (tile-1)/(nbx*nby) + 1
      i  = (bx-1)*blockDim%x + it + 1
      k  = (bz-1)*blockDim%z + kt + 1
      j_base = (by-1)*blockDim%y
      offset_xz = (it-1) * sy + (kt-1) * sy * sx
      do jj = jt-io, threadsF%y+io+1, blockDim%y
        j = j_base + jj
        if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
          idx = jj + offset_xz
          rho(idx) = fltflt_init(Q(i,1,j,k));   u(idx) = fltflt_init(Q(i,2,j,k))
            v(idx) = fltflt_init(Q(i,3,j,k));   w(idx) = fltflt_init(Q(i,4,j,k))
            p(idx) = fltflt_init(Q(i,5,j,k)); tmp(idx) = fltflt_init(T(i,j,k))
        endif
      enddo
      call syncthreads()
      j = j_base + jt
      if (io+1 <= j .and. j <= ny-(io+1) .and. i <= nx-1 .and. k <= nz-1) then
        idx = jt + offset_xz
        ! phase 2: F already holds phase-1's Fv (viscous) contribution -- accumulate.
        F(:,i-1,j,k-1) = F(:,i-1,j,k-1) + KEEP(id_acc, &
                              rho(idx-io:idx+io+1), u(idx-io:idx+io+1), &
                                v(idx-io:idx+io+1), w(idx-io:idx+io+1), &
                               v(idx-io:idx+io+1), p(idx-io:idx+io+1), &
                              tmp(idx-io:idx+io+1), Normal_y_ff)
      endif
      call syncthreads()
    enddo
  end subroutine calc_keep_y_in


  attributes(global) subroutine calc_keep_z_in(nx, ny, nz, nbx, nby, nbz, Q, T, G)
    use mod_constant, only : Normal_z_ff
    integer, intent(in), value                :: nx, ny, nz, nbx, nby, nbz
    real(8), intent(in), device, contiguous   :: Q(nx,5,ny,nz), T(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: G(5,nx-2,ny-2,nz-1)
    integer i, j, k, it, jt, kt
    integer :: kk, k_base, idx, offset_xy
    integer :: tile, ntiles, bx, by, bz
    integer, parameter :: sx = threadsG%x
    integer, parameter :: sy = threadsG%y
    integer, parameter :: sz = threadsG%z + 2*io + 1
    type(fltflt), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    ntiles = nbx * nby * nbz
    do tile = blockIdx%x, ntiles, gridDim%x
      bx = mod(tile-1, nbx) + 1
      by = mod((tile-1)/nbx, nby) + 1
      bz = (tile-1)/(nbx*nby) + 1
      i  = (bx-1)*blockDim%x + it + 1
      j  = (by-1)*blockDim%y + jt + 1
      k_base = (bz-1)*blockDim%z
      offset_xy = (jt-1) * sz + (it-1) * sz * sy
      do kk = kt-io, threadsG%z+io+1, blockDim%z
        k = k_base + kk
        if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
          idx = kk + offset_xy
          rho(idx) = fltflt_init(Q(i,1,j,k));   u(idx) = fltflt_init(Q(i,2,j,k))
            v(idx) = fltflt_init(Q(i,3,j,k));   w(idx) = fltflt_init(Q(i,4,j,k))
            p(idx) = fltflt_init(Q(i,5,j,k)); tmp(idx) = fltflt_init(T(i,j,k))
        endif
      enddo
      call syncthreads()
      k = k_base + kt
      if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
        idx = kt + offset_xy
        ! phase 3: G already holds phase-2's Gv (viscous) contribution -- accumulate.
        G(:,i-1,j-1,k) = G(:,i-1,j-1,k) + KEEP(id_acc, &
                              rho(idx-io:idx+io+1), u(idx-io:idx+io+1), &
                                v(idx-io:idx+io+1), w(idx-io:idx+io+1), &
                               w(idx-io:idx+io+1), p(idx-io:idx+io+1), &
                              tmp(idx-io:idx+io+1), Normal_z_ff)
      endif
      call syncthreads()
    enddo
  end subroutine calc_keep_z_in


end module calc_keep_kernel_internal
