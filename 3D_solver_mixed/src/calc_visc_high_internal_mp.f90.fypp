! real(4)-internal port of 3D_solver/src/calc_visc_high_internal.f90.fypp,
! VISC_ORDER=6 (cent6 stencil) and VISC='NS' (no LES) only -- matches NSTGV's
! config.fypp exactly. calc_Ev6_in_mp/calc_Fv6_in_mp/calc_Gv6_in_mp keep the
! IDENTICAL intent(inout) real(8) contract on E/F/G as the baseline real(8)
! kernels -- only the stencil arithmetic inside each kernel (loaded via
! load_smem_visc_cent_mp's real(4) shared tiles, local mu6/T6 arrays,
! calc_tau_straight_mp/calc_tau_cross_mp) runs in FP32. The final
! txx/txy/txz/kTx terms promote back to real(8) implicitly in the
! `E(...) = E(...) - txx` accumulate.
!
! Perfect-SoA / mixed-precision layout: E/F/G use the shared baseline's
! trailing-5 layout (E(nx-1,ny-2,nz-2,5) etc., matching
! 3D_solver/src/preprocess.f90.fypp's allocation). The old real(8) Q/T/dx/dy/dz
! dummy args are replaced by the persistent real(4) mirrors u_r4/v_r4/w_r4/
! T_r4 (calc_physical_quantities_mixed, written once per RK stage by
! calc_quantities_T_3D_mixed alongside the real(8) Q/T it still produces for
! the convective path) and dx_r4/dy_r4/dz_r4 (aliases of the caller's
! inv_dx_r4/inv_dy_r4/inv_dz_r4, populated once in preprocess.f90.fypp's
! pre_calc). mu was already real(4) here; it is now real(4)-*native* end to
! end (allocated real(4) by preprocess.f90.fypp under MIXED_FORK) instead of
! being cast down from a real(8) buffer on every thread -- this, together
! with the T_r4/dx_r4 mirrors, eliminates the redundant per-thread
! real(8)->real(4) casts (`real(mu(...),4)`, `real(T(...),4)`,
! `real(dx(i),4)`) the previous version of this file performed on every
! overlapping stencil thread. No change to preprocess.f90.fypp's E/F/G
! shapes or calc_steps.f90 needed.
#:include 'config.fypp'
module calc_visc_high_internal_mp
  use libm
  use mod_globals, only : threadsEv, threadsFv, threadsGv
  use mod_constant, only : Cp_over_Pr
  use load_smem_visc_cent_mp
  implicit none
  private
  public calc_Ev6_in_mp, calc_Fv6_in_mp, calc_Gv6_in_mp, &
         calc_Ev6_in_koff_mp, calc_Fv6_in_koff_mp, calc_Gv6_in_koff_mp
  real(4), parameter :: two_third_mp = 2._4 / 3._4
contains
  #:include 'calc_visc_cent_mp.f90.fypp'

#:for is_koff in [False, True]
  #:set suf = '_in_koff_mp' if is_koff else '_in_mp'
  attributes(global) subroutine calc_Ev6${suf}$(nx, ny, nz, dx_r4, dy_r4, dz_r4, u_r4, v_r4, w_r4, T_r4, mu, &
      vy, wz, &
    #:if is_koff
      k_lo, k_hi, &
    #:endif
      E)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(4), intent(in), device, contiguous    :: dx_r4(nx-1)
    real(4), intent(in), device, contiguous    :: dy_r4(ny-1)
    real(4), intent(in), device, contiguous    :: dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: u_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: v_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: w_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: T_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div_mp
    real(4), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div_mp
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    integer, parameter :: io_v = 2
    integer, parameter :: sx = threadsEv%x + 2*io_v + 1
    integer, parameter :: sy = threadsEv%y
    integer, parameter :: sz = threadsEv%z
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uy
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uz
    integer i, j, k, it, jt, kt, idx, offset_yz
    real(4) :: txx, txy, txz, utxx, vtxy, wtxz, kTx
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_yz = (jt-1)*sx + (kt-1)*sx*sy
    call load_smem_visc_cent_mp_x(it, jt, kt, j, k, nx, ny, nz, dy_r4, dz_r4, u_r4, v_r4, w_r4, u, v, w, uy, uz)
    i  = (blockIdx%x-1)*blockDim%x + it
    idx = it + offset_yz
    #:if is_koff
    if (nx-1 < i .or. ny-1 < j .or. k_hi < k) return
    #:else
    if (nx-1 < i .or. ny-1 < j .or. nz-1 < k) return
    #:endif
    if (3 <= i .and. i <= nx-3 .and. 4 <= j .and. j <= ny-3 .and. 4 <= k .and. k <= nz-3) then
      block
        real(4) :: mu6(6), T6(6)
        mu6(:) = mu(i-2:i+3, j, k)
        T6(:) = T_r4(i-2:i+3, j, k)
        kTx = real(Cp_over_Pr,4) * interp6_mp(mu6) * diff6_mp(dx_r4(i), T6)
        call calc_tau_straight_mp(mu6, u(idx-2:idx+3), vy(i-2:i+3,j,k), wz(i-2:i+3,j,k), dx_r4(i), txx, utxx)
        call calc_tau_cross_mp(mu6, v(idx-2:idx+3), uy(idx-2:idx+3), dx_r4(i), txy, vtxy)
        call calc_tau_cross_mp(mu6, w(idx-2:idx+3), uz(idx-2:idx+3), dx_r4(i), txz, wtxz)
        E(i,j-1,k-1,2) = E(i,j-1,k-1,2) - txx
        E(i,j-1,k-1,3) = E(i,j-1,k-1,3) - txy
        E(i,j-1,k-1,4) = E(i,j-1,k-1,4) - txz
        E(i,j-1,k-1,5) = E(i,j-1,k-1,5) - (utxx + vtxy + wtxz + kTx)
      end block
    endif
  end subroutine calc_Ev6${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = '_in_koff_mp' if is_koff else '_in_mp'
  attributes(global) subroutine calc_Fv6${suf}$(nx, ny, nz, dx_r4, dy_r4, dz_r4, u_r4, v_r4, w_r4, T_r4, mu, &
      ux, wz, &
    #:if is_koff
      k_lo, k_hi, &
    #:endif
      F)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(4), intent(in), device, contiguous    :: dx_r4(nx-1)
    real(4), intent(in), device, contiguous    :: dy_r4(ny-1)
    real(4), intent(in), device, contiguous    :: dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: u_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: v_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: w_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: T_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div_mp
    real(4), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div_mp
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    integer, parameter :: io_v = 2
    integer, parameter :: sx = threadsFv%x
    integer, parameter :: sy = threadsFv%y + 2*io_v + 1
    integer, parameter :: sz = threadsFv%z
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vx
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vz
    integer i, j, k, it, jt, kt, idx, offset_xz
    real(4) :: tyx, tyy, tyz, utyx, vtyy, wtyz, kTy
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_xz = (it-1)*sy + (kt-1)*sy*sx
    call load_smem_visc_cent_mp_y(it, jt, kt, i, k, nx, ny, nz, dx_r4, dz_r4, u_r4, v_r4, w_r4, u, v, w, vx, vz)
    j  = (blockIdx%y-1)*blockDim%y + jt
    idx = jt + offset_xz
    #:if is_koff
    if (nx-1 < i .or. ny-1 < j .or. k_hi < k) return
    #:else
    if (nx-1 < i .or. ny-1 < j .or. nz-1 < k) return
    #:endif
    if (4 <= i .and. i <= nx-3 .and. 3 <= j .and. j <= ny-3 .and. 4 <= k .and. k <= nz-3) then
      block
        real(4) :: mu6(6), T6(6), wz6(6), ux6(6)
        mu6(:) = mu(i, j-2:j+3, k)
        T6(:) = T_r4(i, j-2:j+3, k)
        wz6(:) = wz(i, j-2:j+3, k)
        ux6(:) = ux(i, j-2:j+3, k)
        kTy = real(Cp_over_Pr,4) * interp6_mp(mu6) * diff6_mp(dy_r4(j), T6)
        call calc_tau_straight_mp(mu6, v(idx-2:idx+3), wz6, ux6, dy_r4(j), tyy, vtyy)
        call calc_tau_cross_mp(mu6, u(idx-2:idx+3), vx(idx-2:idx+3), dy_r4(j), tyx, utyx)
        call calc_tau_cross_mp(mu6, w(idx-2:idx+3), vz(idx-2:idx+3), dy_r4(j), tyz, wtyz)
        F(i-1,j,k-1,2) = F(i-1,j,k-1,2) - tyx
        F(i-1,j,k-1,3) = F(i-1,j,k-1,3) - tyy
        F(i-1,j,k-1,4) = F(i-1,j,k-1,4) - tyz
        F(i-1,j,k-1,5) = F(i-1,j,k-1,5) - (utyx + vtyy + wtyz + kTy)
      end block
    endif
  end subroutine calc_Fv6${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = '_in_koff_mp' if is_koff else '_in_mp'
  attributes(global) subroutine calc_Gv6${suf}$(nx, ny, nz, dx_r4, dy_r4, dz_r4, u_r4, v_r4, w_r4, T_r4, mu, &
      ux, vy, &
    #:if is_koff
      k_lo, k_hi, &
    #:endif
      G)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(4), intent(in), device, contiguous    :: dx_r4(nx-1)
    real(4), intent(in), device, contiguous    :: dy_r4(ny-1)
    real(4), intent(in), device, contiguous    :: dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: u_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: v_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: w_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: T_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div_mp
    real(4), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div_mp
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    integer, parameter :: io_v = 2
    integer, parameter :: sx = threadsGv%x
    integer, parameter :: sy = threadsGv%y
    integer, parameter :: sz = threadsGv%z + 2*io_v + 1
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wx
    real(4), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wy
    integer i, j, k, it, jt, kt, idx, offset_xy
    real(4) :: tzx, tzy, tzz, utzx, vtzy, wtzz, kTz
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    offset_xy = (jt-1)*sz + (it-1)*sz*sy
    #:if is_koff
    call load_smem_visc_cent_mp_z_koff(it, jt, kt, i, j, nx, ny, nz, dx_r4, dy_r4, u_r4, v_r4, w_r4, u, v, w, wx, wy, k_lo)
    k  = (blockIdx%z-1)*blockDim%z + k_lo - 1 + kt
    if (nx-1 < i .or. ny-1 < j .or. k_hi < k) return
    #:else
    call load_smem_visc_cent_mp_z(it, jt, kt, i, j, nx, ny, nz, dx_r4, dy_r4, u_r4, v_r4, w_r4, u, v, w, wx, wy)
    k  = (blockIdx%z-1)*blockDim%z + kt
    if (nx-1 < i .or. ny-1 < j .or. nz-1 < k) return
    #:endif
    idx = kt + offset_xy
    if (4 <= i .and. i <= nx-3 .and. 4 <= j .and. j <= ny-3 .and. 3 <= k .and. k <= nz-3) then
      block
        real(4) :: mu6(6), T6(6), ux6(6), vy6(6)
        mu6(:) = mu(i, j, k-2:k+3)
        T6(:) = T_r4(i, j, k-2:k+3)
        ux6(:) = ux(i, j, k-2:k+3)
        vy6(:) = vy(i, j, k-2:k+3)
        kTz = real(Cp_over_Pr,4) * interp6_mp(mu6) * diff6_mp(dz_r4(k), T6)
        call calc_tau_straight_mp(mu6, w(idx-2:idx+3), ux6, vy6, dz_r4(k), tzz, wtzz)
        call calc_tau_cross_mp(mu6, u(idx-2:idx+3), wx(idx-2:idx+3), dz_r4(k), tzx, utzx)
        call calc_tau_cross_mp(mu6, v(idx-2:idx+3), wy(idx-2:idx+3), dz_r4(k), tzy, vtzy)
        G(i-1,j-1,k,2) = G(i-1,j-1,k,2) - tzx
        G(i-1,j-1,k,3) = G(i-1,j-1,k,3) - tzy
        G(i-1,j-1,k,4) = G(i-1,j-1,k,4) - tzz
        G(i-1,j-1,k,5) = G(i-1,j-1,k,5) - (utzx + vtzy + wtzz + kTz)
      end block
    endif
  end subroutine calc_Gv6${suf}$
#:endfor
end module calc_visc_high_internal_mp
