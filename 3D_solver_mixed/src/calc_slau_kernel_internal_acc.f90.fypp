#:include 'config.fypp'
! Accumulate variants of calc_slau_y_in/calc_slau_z_in
! (3D_solver/src/calc_slau_kernel_internal.f90.fypp), used ONLY by
! calc_conv_visc_paired_mixed's F/G phases. That dispatcher launches Fv/Gv
! (viscous) BEFORE the paired convective kernel, so E||Fv, F||Gv, G||Ev can
! run concurrently on separate Green-Context streams -- but Fv/Gv write a
! fresh (zeroed-baseline) value into F/G first, and the convective kernel
! must then ADD its flux on top, not overwrite it (SLAU1/HRSLAU2's flux
! outputs are intent(out), so calling them with F(...)/G(...) directly, as
! the baseline calc_slau_y_in/z_in do, is a fresh write -- fine for the
! plain sequential dispatch where convective always runs first, but wrong
! here). calc_slau_y_in_acc/calc_slau_z_in_acc route the flux through local
! scalars first, then explicitly accumulate onto F/G.
!
! This fork is NSTGV-only (ORDER=6, SLAU_VARIANT='HRSLAU2' fixed in
! config.fypp), so unlike the generic baseline this calls interp6/HRSLAU2
! directly -- no ORDER/SLAU_VARIANT dispatch needed.
module calc_slau_kernel_internal_acc
  use libm
  use mod_globals, only : gamma, threadsF, threadsG
  use mod_constant, only : id_slau, over_gamma_1
  use calc_muscl
  use calc_hybrid
  implicit none
  private
  public calc_slau_y_in_acc, calc_slau_z_in_acc
  integer, parameter :: io = ${ORDER_IO}$
  integer(8), parameter :: id_acc = 0_8
contains
  include 'calc_slau_3d.f90'

  !$dir inline
  attributes(device) subroutine interp6_acc(id_accuracy, rho,  u,  v,  w,  p, &
                                                     rhol, ul, vl, wl, pl, &
                                                     rhor, ur, vr, wr, pr, fd)
    integer(8), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(6), u(6), v(6), w(6), p(6)
    real(8), intent(out)            :: rhol, ul, vl, wl, pl
    real(8), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)         :: fd
    call delta6(fd, rho(:), rhol, rhor)
    call delta6(fd,   u(:),   ul,   ur)
    call delta6(fd,   v(:),   vl,   vr)
    call delta6(fd,   w(:),   wl,   wr)
    call delta6(fd,   p(:),   pl,   pr)
    fd = wiggle_detector(p(2:5))
  end subroutine interp6_acc


  attributes(global) subroutine calc_slau_y_in_acc(nx, ny, nz, Q, sensor, F)
    use mod_constant, only : Normal_y
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: Q(nx,5,ny,nz)
    real(sp), intent(in), device, contiguous   :: sensor(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: F(5,nx-2,ny-1,nz-2)
    integer i, j, k, it, jt, kt
    integer jj, j_base, idx, idx_r, offset_xz, offset_xzr, i1, i2
    integer, parameter :: sx  = threadsF%x
    integer, parameter :: sy  = threadsF%y + 2*io + 1
    integer, parameter :: syr = threadsF%y
    integer, parameter :: sz  = threadsF%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    real(8), dimension(sx*syr*sz), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(8) f1, f2, f3, f4, f5
    real(sp) fdy  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    j_base     = (blockIdx%y-1)*blockDim%y
    offset_xz  = (it-1) * sy  + (kt-1) * sy  * sx
    offset_xzr = (it-1) * syr + (kt-1) * syr * sx
    do jj = jt-io, threadsF%y+io+1, blockDim%y
      j = j_base + jj
      if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
        idx = jj + offset_xz
        rho(idx) = Q(i,1,j,k); u(idx) = Q(i,2,j,k); v(idx) = Q(i,3,j,k)
          w(idx) = Q(i,4,j,k); p(idx) = Q(i,5,j,k)
      endif
    enddo
    call syncthreads()
    j = (blockIdx%y-1)*blockDim%y + jt
    if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
      idx   = jt + offset_xz
      idx_r = jt + offset_xzr
      i1    = idx - io
      i2    = idx + io + 1
      fdy   = 0.50_sp * (sensor(i,j,k) + sensor(i,j+1,k))
      call interp6_acc(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                  rhol,        ul,        vl,        wl,        pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdy)
    endif
    call syncthreads()
    if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
      associate(un1 => v(idx), un2 => vr(idx_r))
        call HRSLAU2(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_y, fdy, &
                  f1, f2, f3, f4, f5)
      end associate
      F(1,i-1,j,k-1) = F(1,i-1,j,k-1) + f1
      F(2,i-1,j,k-1) = F(2,i-1,j,k-1) + f2
      F(3,i-1,j,k-1) = F(3,i-1,j,k-1) + f3
      F(4,i-1,j,k-1) = F(4,i-1,j,k-1) + f4
      F(5,i-1,j,k-1) = F(5,i-1,j,k-1) + f5
    endif
  end subroutine calc_slau_y_in_acc


  attributes(global) subroutine calc_slau_z_in_acc(nx, ny, nz, Q, sensor, G)
    use mod_constant, only : Normal_z
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: Q(nx,5,ny,nz)
    real(sp), intent(in), device, contiguous   :: sensor(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: G(5,nx-2,ny-2,nz-1)
    integer i, j, k, it, jt, kt
    integer kk, k_base, idx, idx_r, offset_xy, offset_xyr, i1, i2
    integer, parameter :: sx  = threadsG%x
    integer, parameter :: sy  = threadsG%y
    integer, parameter :: sz  = threadsG%z + 2*io + 1
    integer, parameter :: szr = threadsG%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    real(8), dimension(sx*sy*szr), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(8) f1, f2, f3, f4, f5
    real(sp) fdz  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base     = (blockIdx%z-1)*blockDim%z
    offset_xy  = (jt-1) * sz  + (it-1) * sz  * sy
    offset_xyr = (jt-1) * szr + (it-1) * szr * sy
    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz) then
        idx = kk + offset_xy
        rho(idx) = Q(i,1,j,k); u(idx) = Q(i,2,j,k); v(idx) = Q(i,3,j,k)
          w(idx) = Q(i,4,j,k); p(idx) = Q(i,5,j,k)
      endif
    enddo
    call syncthreads()
    k = (blockIdx%z-1)*blockDim%z + kt
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      idx   = kt + offset_xy
      idx_r = kt + offset_xyr
      i1    = idx - io
      i2    = idx + io + 1
      fdz   = 0.50_sp * (sensor(i,j,k) + sensor(i,j,k+1))
      call interp6_acc(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                  rhol,        ul,        vl,        wl,        pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdz)
    endif
    call syncthreads()
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
      associate(un1 => w(idx), un2 => wr(idx_r))
        call HRSLAU2(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_z, fdz, &
                  f1, f2, f3, f4, f5)
      end associate
      G(1,i-1,j-1,k) = G(1,i-1,j-1,k) + f1
      G(2,i-1,j-1,k) = G(2,i-1,j-1,k) + f2
      G(3,i-1,j-1,k) = G(3,i-1,j-1,k) + f3
      G(4,i-1,j-1,k) = G(4,i-1,j-1,k) + f4
      G(5,i-1,j-1,k) = G(5,i-1,j-1,k) + f5
    endif
  end subroutine calc_slau_z_in_acc
end module calc_slau_kernel_internal_acc
