! real(4) port of 3D_solver/src/calc_visc_cent.f90.fypp, VISC_ORDER=6 (cent6) only.
! #:include'd bodily into calc_visc_high_internal_mp.f90.fypp's module body, same
! as the baseline does with calc_visc_cent.f90.fypp -- these become private
! procedures of whichever module includes this file. All arguments (mu, u, vy,
! wz, v, uy, w, uz, d) are real(4): the caller (calc_visc_high_internal_mp)
! casts Q/T/mu/dx/dy/dz down from the real(8) module-level arrays once, so the
! whole stencil evaluation here runs in FP32 -- promoting back to real(8) mid-
! computation would defeat the point of the FP32 viscous path. Procedure names
! are suffixed _mp (not the baseline's unsuffixed interp6/diff6/calc_tau_*) so
! -Minline=name:... in CMakeLists.txt can force-inline these specifically
! without any ambiguity against the real(8) baseline names.
  pure attributes(device) function interp6_mp(a) result(ai)
    real(4), intent(in), contiguous :: a(6)
    real(4) ai
    ai = 0.00390625_4 * (3._4*a(1) - 25._4*a(2) + 150._4*(a(3)+a(4)) - 25._4*a(5) + 3._4*a(6))
  end function interp6_mp

  pure attributes(device) function diff6_mp(d, a) result(da)
    real(4), intent(in)             :: d
    real(4), intent(in), contiguous :: a(6)
    real(4) da
    da = (-0.0046875_4*a(1) + 0.065104167_4*a(2) - 1.171875_4*(a(3)-a(4)) - 0.065104167_4*a(5) + 0.0046875_4*a(6)) * d
  end function diff6_mp

  pure attributes(device) subroutine calc_tau_straight_mp(mu, u, vy, wz, d, t11, ut11)
    real(4), intent(in), contiguous :: mu(6)
    real(4), intent(in), contiguous :: u(6)
    real(4), intent(in), contiguous :: vy(6)
    real(4), intent(in), contiguous :: wz(6)
    real(4), intent(in)             :: d
    real(4), intent(out)            :: t11
    real(4), intent(out)            :: ut11
    real(4) mui, vyi, wzi, ux
    mui  = interp6_mp(mu)
    vyi  = interp6_mp(vy)
    wzi  = interp6_mp(wz)
    ux   = diff6_mp(d, u)
    t11  = two_third_mp * mui * (2._4 * ux - vyi - wzi)
    ut11 = interp6_mp(u) * t11
  end subroutine calc_tau_straight_mp

  pure attributes(device) subroutine calc_tau_cross_mp(mu, v, uy, d, t12, vt12)
    real(4), intent(in), contiguous :: mu(6)
    real(4), intent(in), contiguous :: v(6)
    real(4), intent(in), contiguous :: uy(6)
    real(4), intent(in)             :: d
    real(4), intent(out)            :: t12
    real(4), intent(out)            :: vt12
    real(4) mui, uyi, vx
    mui  = interp6_mp(mu)
    uyi  = interp6_mp(uy)
    vx   = diff6_mp(d, v)
    t12  = mui * (uyi + vx)
    vt12 = interp6_mp(v) * t12
  end subroutine calc_tau_cross_mp
