! Forked from 3D_solver/src/calc_time_dev.f90.fypp -- NSTGV only uses the
! RK==3, not RESCALE, not COMMZ branch, so only that branch is carried over
! (unused for this fork: calc_rescale, calc_para, nvtx -- none of their
! exported names are referenced by this branch's body). The only change
! from the baseline branch is the init_streams() call, gated behind
! OVERLAP_GC, which sets up the Green Context stream/SM split once before
! any GPU memory allocation or kernel launch (mirrors where
! 3D_solver_fltflt/src/calc_time_dev_ff.f90.fypp calls it).
!
! Perfect-SoA / mixed-precision layout: Q(nx,5,ny,nz) -> Q(nx,ny,nz,5) on the
! host; device Q/QJ/QJ2 are fully split into Q_1..Q_5/QJ_1..QJ_5/QJ2_1..QJ2_5.
! mu is real(4) (MIXED_FORK-gated in preprocess.f90.fypp); T/mut/qc2 stay
! real(8). New persistent real(4) mirrors inv_dx_r4/inv_dy_r4/inv_dz_r4 are
! allocated/populated once in preprocess.f90.fypp's allocate_device_mem/
! pre_calc and threaded straight into calc_EFG each RK stage. u_r4/v_r4/w_r4/
! T_r4 are owned by calc_physical_quantities_mixed (module-level, allocated
! once via init_physical_quantities_mixed), not by this subroutine.
#:include 'config.fypp'
module calc_time_dev
  use cudafor
  use mpi
  use mod_globals, only : nt, np, &
  & blocks, threads, blocksE, blocksF, blocksG, threadsE, threadsF, threadsG, &
  & blocksEv, blocksFv, blocksGv, threadsEv, threadsFv, threadsGv
  use mod_constant, only : one_third
  use calc_flux_base
  use calc_steps
  use set
  use preprocess
  use calc_physical_quantities_mixed, only : init_physical_quantities_mixed
  #:if OVERLAP_GC
  use mod_streams_mixed, only : init_streams
  #:endif
  use print
  implicit none
  public RungeKutta
contains

  !> 3rd-order TVD Runge-Kutta time stepping without rescaling
  !> Solves dQ/dt = RHS(Q) using total variation diminishing (TVD) 3-stage scheme
  !> Stages: Q(1) = Q^n + (dt)*RHS(Q^n); Q(2) = (3/4)*Q^n + (1/4)*Q(1) + (1/4)*dt*RHS(Q(1))
  !>         Q^(n+1) = (1/3)*Q^n + (2/3)*Q(2) + (2/3)*dt*RHS(Q(2))
  !> TVD property: |Q^(n+1)|_TV <= |Q^n|_TV prevents spurious oscillations near shocks
  !> GPU computation: Each rank manages one GPU asynchronously; MPI sync only for I/O
  subroutine RungeKutta(myrank, mygpu, nx, ny, nz, x, dx_cpu, y, dy_cpu, z, dz_cpu, Jacobian_cpu, Q)
    integer, intent(in)    :: myrank                            !< MPI rank
    integer, intent(in)    :: mygpu                             !< GPU index for this rank
    integer, intent(in)    :: nx                                !< x grid dimension
    integer, intent(in)    :: ny                                !< y grid dimension
    integer, intent(in)    :: nz                                !< z grid dimension
    real(8), intent(in)    :: x(nx)                             !< x coordinates
    real(8), intent(in)    :: dx_cpu(nx-1)                      !< inverse x spacing (host)
    real(8), intent(in)    :: y(ny)                             !< y coordinates
    real(8), intent(in)    :: dy_cpu(ny-1)                      !< inverse y spacing (host)
    real(8), intent(in)    :: z(nz)                             !< z coordinates
    real(8), intent(in)    :: dz_cpu(nz-1)                      !< inverse z spacing (host)
    real(8), intent(in)    :: Jacobian_cpu(nx,ny)               !< Jacobian determinant (host)
    real(8), intent(inout) :: Q(nx,ny,nz,5)                     !< conservative variables on host
    integer i, j, k, l, t1, t2, ierr, nranks, ndevices, stat
    integer istat(MPI_STATUS_SIZE)
    ! GPU !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    real(8), allocatable, device :: Q_1(:,:,:), Q_2(:,:,:), Q_3(:,:,:), Q_4(:,:,:), Q_5(:,:,:)
    real(8), allocatable, device :: QJ_1(:,:,:), QJ_2(:,:,:), QJ_3(:,:,:), QJ_4(:,:,:), QJ_5(:,:,:)
    real(8), allocatable, device :: QJ2_1(:,:,:), QJ2_2(:,:,:), QJ2_3(:,:,:), QJ2_4(:,:,:), QJ2_5(:,:,:)
    real(8), allocatable, device :: E(:,:,:,:), F(:,:,:,:), G(:,:,:,:)
    real(8), allocatable, device :: T(:,:,:), mut(:,:,:), qc2(:,:,:)
    real(4), allocatable, device :: mu(:,:,:)
    real(4), allocatable, device :: inv_dx_r4(:), inv_dy_r4(:), inv_dz_r4(:)
    real(8), allocatable, device :: xix(:), etay(:), zetaz(:), Jacobian(:,:), dtdxdy(:,:), dtdydz(:,:), dtdzdx(:,:)
    ! for plot
    real(4) :: ke0 = 1.d0, entropy0 = 1.d0

    call MPI_COMM_SIZE(MPI_COMM_WORLD, nranks, ierr)
    ! count GPU
    stat = cudaGetDeviceCount(ndevices)
    print *, "rank", myrank, " has found ", ndevices, " GPU devices"
    if (mod(myrank,2) == 0) then
      call check_gpu(mygpu)
      #:if OVERLAP_GC
      call init_streams(mygpu)
      #:endif
      call allocate_device_mem(myrank, nx, ny, nz, dtdxdy, dtdydz, dtdzdx, xix, etay, zetaz, Jacobian, &
                                Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, E, F, G, inv_dx_r4, inv_dy_r4, inv_dz_r4)
      call init_physical_quantities_mixed(nx, ny, nz)
      allocate(QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz), QJ_4(nx,ny,nz), QJ_5(nx,ny,nz), &
               QJ2_1(nx,ny,nz), QJ2_2(nx,ny,nz), QJ2_3(nx,ny,nz), QJ2_4(nx,ny,nz), QJ2_5(nx,ny,nz), stat=ierr)
      if (ierr /= 0) then
        print *, "myrank is ", myrank, " memory allocation failed", ierr
      else
        print *, "myrank is ", myrank, " memory allocation has completed"
      endif
      call pre_calc(nx, ny, nz, myrank, nranks, x, dx_cpu, y, dy_cpu, z, dz_cpu, Jacobian_cpu, Q, &
                    dtdxdy, dtdydz, dtdzdx, xix, etay, zetaz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, ke0, entropy0, &
                    inv_dx_r4, inv_dy_r4, inv_dz_r4)
    else
      call MPI_RECV(ke0,      1, MPI_REAL4, myrank-1, myrank,   MPI_COMM_WORLD, istat, ierr)
      call MPI_RECV(entropy0, 1, MPI_REAL4, myrank-1, myrank,   MPI_COMM_WORLD, istat, ierr)
      call send_recv_for_print_odd(myrank, nranks, 0, nx, ny, nz, x, y, z, Jacobian_cpu, Q, ke0, entropy0)
    endif

    !> Time integration main loop with MPI domain decomposition
    !> Each rank computes assigned 3D subdomain on dedicated GPU independently
    !> Synchronization points: (1) end of each time integration step for boundary exchange
    !>                         (2) after every np iterations for I/O and statistics
    !> CFL constraint: dt = CFL * min_grid_spacing / max_wave_speed
    call MPI_BARRIER(MPI_COMM_WORLD, ierr)
    print *, "myrank is ", myrank, " start Runge-Kutta"
    do t2 = 1, np
      if (mod(myrank,2) == 0) then
        ! GPU-accelerated ranks perform time integration
        do t1 = 1, nt
          ! Step 1: Compute fluxes E, F, G from current state QJ
          call calc_EFG(nx, ny, nz, xix, etay, zetaz, Jacobian, &
                        QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, &
                        inv_dx_r4, inv_dy_r4, inv_dz_r4, E, F, G, 1, nz-1)
          ! Step 2a: TVD RK3 Stage 1 - compute Q(1), store in QJ2
          call calc_step1<<<blocks,threads>>>(nx, ny, nz, 1.d0, dtdxdy, dtdydz, dtdzdx, E, F, G, &
                        QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5)
          ! Enforce boundary conditions at cell interfaces (extrapolation or characteristic-based)
          call set_bc(myrank, nx, ny, nz, Jacobian, QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5)

          ! Step 2b: TVD RK3 Stage 2 - blend Q(1) with Q^n, store in QJ2
          call calc_EFG(nx, ny, nz, xix, etay, zetaz, Jacobian, &
                        QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, &
                        inv_dx_r4, inv_dy_r4, inv_dz_r4, E, F, G, 1, nz-1)
          call calc_step2_3<<<blocks,threads>>>(nx, ny, nz, 0.75d0, 0.25d0, 0.25d0, 1.d0, dtdxdy, dtdydz, dtdzdx, E, F, G, &
                        QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5)
          call set_bc(myrank, nx, ny, nz, Jacobian, QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5)

          ! Step 2c: TVD RK3 Stage 3 - final solution Q^(n+1), store in QJ (swap arrays)
          call calc_EFG(nx, ny, nz, xix, etay, zetaz, Jacobian, &
                        QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, &
                        inv_dx_r4, inv_dy_r4, inv_dz_r4, E, F, G, 1, nz-1)
          call calc_step2_3<<<blocks,threads>>>(nx, ny, nz, 2.d0, 1.d0, 2.d0, one_third, dtdxdy, dtdydz, dtdzdx, E, F, G, &
                        QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5)
          call set_bc(myrank, nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5)
        enddo
      endif
      if (mod(myrank, 2) == 0) then
        call send_recv_for_print_even(myrank, nranks, t2, nx, ny, nz, x, y, z, Jacobian_cpu, &
                      QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q, ke0, entropy0)
      else
        call send_recv_for_print_odd(myrank, nranks, t2, nx, ny, nz, x, y, z, Jacobian_cpu, Q, ke0, entropy0)
      endif
    enddo

    if (mod(myrank,2) == 0) then
      deallocate(Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, &
                 QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ2_5, &
                 E, F, G, xix, etay, zetaz, Jacobian, dtdxdy, dtdydz, dtdzdx, &
                 inv_dx_r4, inv_dy_r4, inv_dz_r4)
    endif
    print *, "myrank is ", myrank, " deallocate GPU memory"
  end subroutine RungeKutta
end module calc_time_dev
