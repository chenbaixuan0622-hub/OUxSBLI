! real(4) port of 3D_solver/src/load_smem_visc_cent.f90.fypp, VISC_ORDER=6
! (cent6) only. The baseline loader uses pipelineMemcpyAsync (cp.async-style
! raw byte copy, see wmma/load_smem_visc2.f90) to prefetch Q (real8) straight
! into real8 shared tiles -- cp.async moves bytes, it cannot narrow fp64 to
! fp32. So this loader does a plain synchronous load instead, but now reads
! directly from the persistent real(4) mirrors u_r4/v_r4/w_r4
! (calc_physical_quantities_mixed) and the real(4) grid-metric mirrors
! inv_dx_r4/inv_dy_r4/inv_dz_r4 (populated once per RK stage / once at
! startup respectively) instead of casting real(8) Q/inv_dx down on every
! thread (`u(idx) = real(Q(i,2,j,k), 4)`) -- this was the redundant
! per-thread real(8)->real(4) cast this fork's mixed-precision task set out
! to eliminate. Only the two transverse inv_d* mirrors each direction's
! loader actually needs are threaded through (matching the old inv_dy/inv_dz
! etc. signatures).
#:include 'config.fypp'
module load_smem_visc_cent_mp
  use mod_globals, only : threadsEv, threadsFv, threadsGv
  implicit none
  private
  public load_smem_visc_cent_mp_x, load_smem_visc_cent_mp_y, &
         load_smem_visc_cent_mp_z, load_smem_visc_cent_mp_z_koff
  real(4), parameter :: one_sixty_mp = 1._4 / 60._4
contains
  attributes(device) subroutine load_smem_visc_cent_mp_x(it, jt, kt, j, k, &
                                                       nx, ny, nz, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, u, v, w, uy, uz)
    integer, intent(in), value              :: it
    integer, intent(in), value              :: jt
    integer, intent(in), value              :: kt
    integer, intent(in), value              :: j
    integer, intent(in), value              :: k
    integer, intent(in), value              :: nx
    integer, intent(in), value              :: ny
    integer, intent(in), value              :: nz
    real(4), intent(in), device, contiguous :: inv_dy_r4(ny-1)
    real(4), intent(in), device, contiguous :: inv_dz_r4(nz-1)
    real(4), intent(in), device, contiguous :: u_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: v_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: w_r4(nx,ny,nz)
    integer, parameter :: io_v = 2
    integer, parameter :: sx = threadsEv%x + 2*io_v + 1
    integer, parameter :: sy = threadsEv%y
    integer, parameter :: sz = threadsEv%z
    real(4), intent(inout) ::  u(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  v(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  w(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: uy(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: uz(-(io_v-1):sx*sy*sz-io_v)
    integer i_base, ii, i, idx, offset_yz
    i_base = (blockIdx%x-1)*blockDim%x
    offset_yz = (jt-1)*sx + (kt-1)*sx*sy
    do ii = it-io_v, threadsEv%x+io_v+1, blockDim%x
      i = i_base + ii
      idx = ii + offset_yz
      if (1 <= i .and. i <= nx .and. j <= ny .and. k <= nz) then
        u(idx) = u_r4(i,j,k)
        v(idx) = v_r4(i,j,k)
        w(idx) = w_r4(i,j,k)
      endif
      if (1 <= i .and. i <= nx .and. 4 <= j .and. j <= ny-3 .and. k <= nz) then
        uy(idx) = (one_sixty_mp * (-u_r4(i,j-3,k) + u_r4(i,j+3,k)) + 0.15_4 * (u_r4(i,j-2,k) - u_r4(i,j+2,k)) &
                   + 0.75_4 * (-u_r4(i,j-1,k) + u_r4(i,j+1,k))) * inv_dy_r4(j)
      endif
      if (1 <= i .and. i <= nx .and. j <= ny .and. 4 <= k .and. k <= nz-3) then
        uz(idx) = (one_sixty_mp * (-u_r4(i,j,k-3) + u_r4(i,j,k+3)) + 0.15_4 * (u_r4(i,j,k-2) - u_r4(i,j,k+2)) &
                   + 0.75_4 * (-u_r4(i,j,k-1) + u_r4(i,j,k+1))) * inv_dz_r4(k)
      endif
    enddo
    call syncthreads()
  end subroutine load_smem_visc_cent_mp_x


  attributes(device) subroutine load_smem_visc_cent_mp_y(it, jt, kt, i, k, &
                                                       nx, ny, nz, inv_dx_r4, inv_dz_r4, u_r4, v_r4, w_r4, u, v, w, vx, vz)
    integer, intent(in), value              :: it
    integer, intent(in), value              :: jt
    integer, intent(in), value              :: kt
    integer, intent(in), value              :: i
    integer, intent(in), value              :: k
    integer, intent(in), value              :: nx
    integer, intent(in), value              :: ny
    integer, intent(in), value              :: nz
    real(4), intent(in), device, contiguous :: inv_dx_r4(nx-1)
    real(4), intent(in), device, contiguous :: inv_dz_r4(nz-1)
    real(4), intent(in), device, contiguous :: u_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: v_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: w_r4(nx,ny,nz)
    integer, parameter :: io_v = 2
    integer, parameter :: sx = threadsFv%x
    integer, parameter :: sy = threadsFv%y + 2*io_v + 1
    integer, parameter :: sz = threadsFv%z
    real(4), intent(inout) ::  u(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  v(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  w(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: vx(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: vz(-(io_v-1):sx*sy*sz-io_v)
    integer j_base, jj, j, idx, offset_xz
    j_base = (blockIdx%y-1)*blockDim%y
    offset_xz = (it-1)*sy + (kt-1)*sy*sx
    do jj = jt-io_v, threadsFv%y+io_v+1, blockDim%y
      j = j_base + jj
      idx = jj + offset_xz
      if (i <= nx .and. 1 <= j .and. j <= ny .and. k <= nz) then
        u(idx) = u_r4(i,j,k)
        v(idx) = v_r4(i,j,k)
        w(idx) = w_r4(i,j,k)
      endif
      if (4 <= i .and. i <= nx-3 .and. 1 <= j .and. j <= ny .and. k <= nz) then
        vx(idx) = (one_sixty_mp * (-v_r4(i-3,j,k) + v_r4(i+3,j,k)) + 0.15_4 * (v_r4(i-2,j,k) - v_r4(i+2,j,k)) &
                   + 0.75_4 * (-v_r4(i-1,j,k) + v_r4(i+1,j,k))) * inv_dx_r4(i)
      endif
      if (i <= nx .and. 1 <= j .and. j <= ny .and. 4 <= k .and. k <= nz-3) then
        vz(idx) = (one_sixty_mp * (-v_r4(i,j,k-3) + v_r4(i,j,k+3)) + 0.15_4 * (v_r4(i,j,k-2) - v_r4(i,j,k+2)) &
                   + 0.75_4 * (-v_r4(i,j,k-1) + v_r4(i,j,k+1))) * inv_dz_r4(k)
      endif
    enddo
    call syncthreads()
  end subroutine load_smem_visc_cent_mp_y


  attributes(device) subroutine load_smem_visc_cent_mp_z(it, jt, kt, i, j, &
                                                       nx, ny, nz, inv_dx_r4, inv_dy_r4, u_r4, v_r4, w_r4, u, v, w, wx, wy)
    integer, intent(in), value              :: it
    integer, intent(in), value              :: jt
    integer, intent(in), value              :: kt
    integer, intent(in), value              :: i
    integer, intent(in), value              :: j
    integer, intent(in), value              :: nx
    integer, intent(in), value              :: ny
    integer, intent(in), value              :: nz
    real(4), intent(in), device, contiguous :: inv_dx_r4(nx-1)
    real(4), intent(in), device, contiguous :: inv_dy_r4(ny-1)
    real(4), intent(in), device, contiguous :: u_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: v_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: w_r4(nx,ny,nz)
    integer, parameter :: io_v = 2
    integer, parameter :: sx = threadsGv%x
    integer, parameter :: sy = threadsGv%y
    integer, parameter :: sz = threadsGv%z + 2*io_v + 1
    real(4), intent(inout) ::  u(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  v(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  w(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: wx(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: wy(-(io_v-1):sx*sy*sz-io_v)
    integer k_base, kk, k, idx, offset_xy
    k_base = (blockIdx%z-1)*blockDim%z
    offset_xy = (jt-1)*sz + (it-1)*sz*sy
    do kk = kt-io_v, threadsGv%z+io_v+1, blockDim%z
      k = k_base + kk
      idx = kk + offset_xy
      if (i <= nx .and. j <= ny .and. 1 <= k .and. k <= nz) then
        u(idx) = u_r4(i,j,k)
        v(idx) = v_r4(i,j,k)
        w(idx) = w_r4(i,j,k)
      endif
      if (4 <= i .and. i <= nx-3 .and. j <= ny .and. 1 <= k .and. k <= nz) then
        wx(idx) = (one_sixty_mp * (-w_r4(i-3,j,k) + w_r4(i+3,j,k)) + 0.15_4 * (w_r4(i-2,j,k) - w_r4(i+2,j,k)) &
                   + 0.75_4 * (-w_r4(i-1,j,k) + w_r4(i+1,j,k))) * inv_dx_r4(i)
      endif
      if (i <= nx .and. 4 <= j .and. j <= ny-3 .and. 1 <= k .and. k <= nz) then
        wy(idx) = (one_sixty_mp * (-w_r4(i,j-3,k) + w_r4(i,j+3,k)) + 0.15_4 * (w_r4(i,j-2,k) - w_r4(i,j+2,k)) &
                   + 0.75_4 * (-w_r4(i,j-1,k) + w_r4(i,j+1,k))) * inv_dy_r4(j)
      endif
    enddo
    call syncthreads()
  end subroutine load_smem_visc_cent_mp_z


  attributes(device) subroutine load_smem_visc_cent_mp_z_koff(it, jt, kt, i, j, &
                                                            nx, ny, nz, inv_dx_r4, inv_dy_r4, u_r4, v_r4, w_r4, u, v, w, wx, wy, k_lo)
    integer, intent(in), value              :: it
    integer, intent(in), value              :: jt
    integer, intent(in), value              :: kt
    integer, intent(in), value              :: i
    integer, intent(in), value              :: j
    integer, intent(in), value              :: nx
    integer, intent(in), value              :: ny
    integer, intent(in), value              :: nz
    real(4), intent(in), device, contiguous :: inv_dx_r4(nx-1)
    real(4), intent(in), device, contiguous :: inv_dy_r4(ny-1)
    real(4), intent(in), device, contiguous :: u_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: v_r4(nx,ny,nz)
    real(4), intent(in), device, contiguous :: w_r4(nx,ny,nz)
    integer, intent(in), value              :: k_lo
    integer, parameter :: io_v = 2
    integer, parameter :: sx = threadsGv%x
    integer, parameter :: sy = threadsGv%y
    integer, parameter :: sz = threadsGv%z + 2*io_v + 1
    real(4), intent(inout) ::  u(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  v(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) ::  w(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: wx(-(io_v-1):sx*sy*sz-io_v)
    real(4), intent(inout) :: wy(-(io_v-1):sx*sy*sz-io_v)
    integer k_base, kk, k, idx, offset_xy
    k_base = (blockIdx%z-1)*blockDim%z + k_lo - 1
    offset_xy = (jt-1)*sz + (it-1)*sz*sy
    do kk = kt-io_v, threadsGv%z+io_v+1, blockDim%z
      k = k_base + kk
      idx = kk + offset_xy
      if (i <= nx .and. j <= ny .and. 1 <= k .and. k <= nz) then
        u(idx) = u_r4(i,j,k)
        v(idx) = v_r4(i,j,k)
        w(idx) = w_r4(i,j,k)
      endif
      if (4 <= i .and. i <= nx-3 .and. j <= ny .and. 1 <= k .and. k <= nz) then
        wx(idx) = (one_sixty_mp * (-w_r4(i-3,j,k) + w_r4(i+3,j,k)) + 0.15_4 * (w_r4(i-2,j,k) - w_r4(i+2,j,k)) &
                   + 0.75_4 * (-w_r4(i-1,j,k) + w_r4(i+1,j,k))) * inv_dx_r4(i)
      endif
      if (i <= nx .and. 4 <= j .and. j <= ny-3 .and. 1 <= k .and. k <= nz) then
        wy(idx) = (one_sixty_mp * (-w_r4(i,j-3,k) + w_r4(i,j+3,k)) + 0.15_4 * (w_r4(i,j-2,k) - w_r4(i,j+2,k)) &
                   + 0.75_4 * (-w_r4(i,j-1,k) + w_r4(i,j+1,k))) * inv_dy_r4(j)
      endif
    enddo
    call syncthreads()
  end subroutine load_smem_visc_cent_mp_z_koff
end module load_smem_visc_cent_mp
