#:include 'config.fypp'
module calc_fused_kernel
  use mod_globals, only : threadsE, dx
  use mod_constant, only : R_over_gamma_1, Cp_over_Pr, two_third
  implicit none
  private
  public calc_fused_x
contains
  include 'calc_keep_1d.f90'
  include 'calc_visc_1d.f90'

  attributes(global) subroutine calc_fused_x(nx, ruvwp, T, mu, E)
    integer, intent(in), value               :: nx
    real(8), intent(in), device, contiguous  :: ruvwp(nx,3), T(nx), mu(nx)
    real(8), intent(out), device, contiguous :: E(3,nx-1)
    
    integer i, it, ii, i_base, idx
    ! 🔥 調整：將 half_threads 改為 64 (總執行緒數 128)
    integer, parameter :: half_threads = 64 
    integer, parameter :: sx = half_threads + 1
    
    ! 🔥 調整：擴大 Shared Memory 容納 64 個執行緒
    real(4), dimension(half_threads, 3), shared :: Fk_sh
    real(8), dimension(half_threads, 2), shared :: Fv_sh
    
    real(4), dimension(1:sx), shared :: rho4, u4, p4, tmp4
    
    it = threadIdx%x
    idx = mod(it - 1, half_threads) + 1
    i_base = (blockIdx%x-1)*half_threads
    
    ! ==========================================
    ! 載入資料到 Shared Memory
    ! ==========================================
    if (it <= sx) then
      i = i_base + it
      if (i >= 1 .and. i <= nx) then
        rho4(it) = real(ruvwp(i,1), 4)
        u4(it)   = real(ruvwp(i,2), 4)
        p4(it)   = real(ruvwp(i,3), 4)
        tmp4(it) = real(T(i), 4)
      endif
    endif
    call syncthreads()

    ! 計算全域索引 i
    i = i_base + idx
    if (nx-1 < i) return

    ! ==========================================
    ! 執行緒分流計算 (總共 128 執行緒)
    ! ==========================================
    if (it <= half_threads) then
      ! Thread 1 ~ 64 : 計算對流項
      Fk_sh(idx, :) = KEEP2(rho4(idx:idx+1), u4(idx:idx+1), p4(idx:idx+1), tmp4(idx:idx+1))
      
    else if (it <= 128) then
      ! Thread 65 ~ 128 : 計算黏性項
      Fv_sh(idx, :) = VISC2(ruvwp(i:i+1, 2), T(i:i+1), mu(i:i+1))
    end if
    
    call syncthreads()

    ! ==========================================
    ! 合併寫回 Global Memory
    ! ==========================================
    if (it <= half_threads) then
      E(1,i) = real(Fk_sh(idx, 1), 8)
      E(2,i) = real(Fk_sh(idx, 2), 8) - Fv_sh(idx, 1)
      E(3,i) = real(Fk_sh(idx, 3), 8) - Fv_sh(idx, 2)
    end if
  end subroutine calc_fused_x
end module calc_fused_kernel
