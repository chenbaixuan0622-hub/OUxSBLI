#:include 'config.fypp'
!> 2nd-order viscous flux (Sutherland's-law momentum diffusion + heat
!> conduction). Direct 1D specialization of calc_visc2.f90.fypp: no
!> transverse velocity/cross-derivative terms exist in 1D.
module calc_visc2
  use mod_globals, only : dx, threadsEv
  use mod_constant, only : Cp_over_Pr, two_third
  implicit none
  private
  public calc_Ev2
contains
  include 'calc_visc_1d.f90'

  attributes(global) subroutine calc_Ev2(nx, ruvwp, T, mu, E)
    integer, intent(in), value                 :: nx
    real(8), intent(in), device, contiguous    :: ruvwp(nx,3)
    real(8), intent(in), device, contiguous    :: T(nx)
    real(8), intent(in), device, contiguous    :: mu(nx)
    real(8), intent(inout), device, contiguous :: E(3,nx-1)
    integer, parameter :: sx = threadsEv%x + 1
    real(8), dimension(1:sx), shared :: u
    integer i, it, ii, i_base, idx
    real(8) Fv(2)
    it = threadIdx%x
    i_base = (blockIdx%x-1)*blockDim%x
    do ii = it, threadsEv%x+1, blockDim%x
      i = i_base + ii
      if (i >= 1 .and. i <= nx) then
        u(ii) = ruvwp(i,2)
      endif
    enddo
    call syncthreads()
    i = i_base + it
    if (nx-1 < i) return
    idx = it
    Fv = VISC2(u(idx:idx+1), [T(i), T(i+1)], [mu(i), mu(i+1)])
    E(2,i) = E(2,i) - Fv(1)
    E(3,i) = E(3,i) - Fv(2)
  end subroutine calc_Ev2
end module calc_visc2
