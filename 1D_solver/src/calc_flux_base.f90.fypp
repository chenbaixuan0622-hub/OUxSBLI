#:include 'config.fypp'
!> Convective (KEEP) + viscous (Navier-Stokes, Sutherland's law) flux
!> dispatcher for the 1D solver.
module calc_flux_base
  use mod_globals, only : blocksE, threadsE, blocksEv, threadsEv
  use calc_physical_quantities
  use calc_keep_kernel
  use calc_visc2
  #:if KERNEL_MODE == 'fused'
  use calc_fused_kernel
  #:endif
  implicit none
  private
  public calc_E
contains
  subroutine calc_conv(nx, Q, T, E)
    integer, intent(in), value               :: nx
    real(8), intent(in), device, contiguous  :: Q(nx,3)
    real(8), intent(in), device, contiguous  :: T(nx)
    real(8), intent(out), device, contiguous :: E(3,nx-1)

    real(4), device, allocatable :: Q_f32(:,:), T_f32(:), E_f32(:,:)
    allocate(Q_f32(nx,3), T_f32(nx), E_f32(3,nx-1))
    Q_f32 = real(Q, 4)
    T_f32 = real(T, 4)
     call calc_keep_x<<<blocksE,threadsE>>>(nx, Q_f32, T_f32, E_f32)
     E = real(E_f32, 8)
     deallocate(Q_f32, T_f32, E_f32)
  end subroutine calc_conv


  !> Compute convective + viscous flux for the compressible NS equations
  subroutine calc_E(nx, Q, ruvwp, T, mu, E)
    integer, intent(in), value               :: nx
    real(8), intent(in), device, contiguous  :: Q(nx,3)
    real(8), intent(out), device, contiguous :: ruvwp(nx,3)
    real(8), intent(out), device, contiguous :: T(nx)
    real(8), intent(out), device, contiguous :: mu(nx)
    real(8), intent(out), device, contiguous :: E(3,nx-1)
    call calc_quantities_T_1D(nx, Q, ruvwp, T, mu)
    #:if KERNEL_MODE == 'fused'
    block 
      type(dim3) :: blocks_fused
      ! 每個 Block 推進 32 個點，所以網格數要除以 32
      blocks_fused = dim3((nx - 1 + 32 - 1) / 32, 1, 1)
      ! 強制使用 64 個 Threads (Warp 1 算 conv，Warp 2 算 visc)
      call calc_fused_x<<<blocks_fused, 64>>>(nx, ruvwp, T, mu, E)
    end block
   #:else
    call calc_conv(nx, ruvwp, T, E)
    call calc_Ev2<<<blocksEv,threadsEv>>>(nx, ruvwp, T, mu, E)
    #:endif
  end subroutine calc_E
end module calc_flux_base
